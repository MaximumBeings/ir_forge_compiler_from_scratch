let wo2_2_v5 = wo2_2_v4 - Gwo2_2_s5 * 0.5
let g2_2_v5 = g2_2_v4 - Gg2_2_s5 * 0.5
let n2_2_v5 = n2_2_v4 - Gn2_2_s5 * 0.5
