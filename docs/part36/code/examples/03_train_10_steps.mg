let wq2_2_v1 = wq2_2_v0 - Gwq2_2_s1 * 0.5
let wk2_2_v1 = wk2_2_v0 - Gwk2_2_s1 * 0.5
let wv2_2_v1 = wv2_2_v0 - Gwv2_2_s1 * 0.5
let wo2_2_v1 = wo2_2_v0 - Gwo2_2_s1 * 0.5
let g2_2_v1 = g2_2_v0 - Gg2_2_s1 * 0.5
let n2_2_v1 = n2_2_v0 - Gn2_2_s1 * 0.5
