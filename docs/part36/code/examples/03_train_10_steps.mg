let c1_2_v5 = c1_2_v4 - Gc1_2_s5 * 0.5
let w2_2_v5 = w2_2_v4 - Gw2_2_s5 * 0.5
let c2_2_v5 = c2_2_v4 - Gc2_2_s5 * 0.5
