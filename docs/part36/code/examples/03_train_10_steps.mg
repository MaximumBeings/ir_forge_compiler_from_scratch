let Gc2_1_s1 = col_sum(dX1_s1)
let Gw2_1_s1 = transpose(r_b1_s1) @ dX1_s1
let dpre_b1_s1 = (dX1_s1 @ transpose(w2_1_v0)) * ge(pre_b1_s1, [[0]])
let Gc1_1_s1 = col_sum(dpre_b1_s1)
let Gw1_1_s1 = transpose(u2_b1_s1) @ dpre_b1_s1
let du2_b1_s1 = dpre_b1_s1 @ transpose(w1_1_v0)
let Gn2_1_s1 = col_sum(du2_b1_s1)
let Gg2_1_s1 = col_sum(du2_b1_s1 * ln_hat(x1_b1_s1))
let dx1_b1_s1 = dX1_s1 + ln_back(du2_b1_s1, x1_b1_s1, g2_1_v0)
let Gwo1_1_s1 = transpose(o1_b1_s1) @ dx1_b1_s1
let do1_b1_s1 = dx1_b1_s1 @ transpose(wo1_1_v0)
let dv1_b1_s1 = transpose(a1_b1_s1) @ do1_b1_s1
let da1_b1_s1 = do1_b1_s1 @ transpose(v1_b1_s1)
let ds1_b1_s1 = a1_b1_s1 * (da1_b1_s1 - row_sum(a1_b1_s1 * da1_b1_s1))
let dq1_b1_s1 = ds1_b1_s1 @ k1_b1_s1 * 0.5
let dk1_b1_s1 = transpose(ds1_b1_s1) @ q1_b1_s1 * 0.5
let Gwq1_1_s1 = transpose(u1_b1_s1) @ dq1_b1_s1
let Gwk1_1_s1 = transpose(u1_b1_s1) @ dk1_b1_s1
let Gwv1_1_s1 = transpose(u1_b1_s1) @ dv1_b1_s1
let Gwo2_1_s1 = transpose(o2_b1_s1) @ dx1_b1_s1
let do2_b1_s1 = dx1_b1_s1 @ transpose(wo2_1_v0)
let dv2_b1_s1 = transpose(a2_b1_s1) @ do2_b1_s1
let da2_b1_s1 = do2_b1_s1 @ transpose(v2_b1_s1)
let ds2_b1_s1 = a2_b1_s1 * (da2_b1_s1 - row_sum(a2_b1_s1 * da2_b1_s1))
let dq2_b1_s1 = ds2_b1_s1 @ k2_b1_s1 * 0.5
let dk2_b1_s1 = transpose(ds2_b1_s1) @ q2_b1_s1 * 0.5
let Gwq2_1_s1 = transpose(u1_b1_s1) @ dq2_b1_s1
let Gwk2_1_s1 = transpose(u1_b1_s1) @ dk2_b1_s1
let Gwv2_1_s1 = transpose(u1_b1_s1) @ dv2_b1_s1
let du1_b1_s1 = dq1_b1_s1 @ transpose(wq1_1_v0) + dk1_b1_s1 @ transpose(wk1_1_v0) + dv1_b1_s1 @ transpose(wv1_1_v0) + dq2_b1_s1 @ transpose(wq2_1_v0) + dk2_b1_s1 @ transpose(wk2_1_v0) + dv2_b1_s1 @ transpose(wv2_1_v0)
let Gn1_1_s1 = col_sum(du1_b1_s1)
let Gg1_1_s1 = col_sum(du1_b1_s1 * ln_hat(x0_s1))
let dX0_s1 = dx1_b1_s1 + ln_back(du1_b1_s1, x0_s1, g1_1_v0)
let Ge_s1 = transpose(x) @ dX0_s1
let e_v1 = e_v0 - Ge_s1 * 0.5
let g1_1_v1 = g1_1_v0 - Gg1_1_s1 * 0.5
