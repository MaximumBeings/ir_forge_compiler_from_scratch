# ---- step 1: forward pass, backward pass, update
let x0_s1 = x @ e_v0 + ps
let u1_b1_s1 = ln_out(x0_s1, g1_1_v0, n1_1_v0)
let q1_b1_s1 = u1_b1_s1 @ wq1_1_v0
