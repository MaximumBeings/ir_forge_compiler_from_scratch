# ---- step 6: forward pass, backward pass, update
let x0_s6 = x @ e_v5 + ps
let u1_b1_s6 = ln_out(x0_s6, g1_1_v5, n1_1_v5)
let q1_b1_s6 = u1_b1_s6 @ wq1_1_v5
