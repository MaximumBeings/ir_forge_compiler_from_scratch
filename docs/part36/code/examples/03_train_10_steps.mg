let o2_b1_s1 = a2_b1_s1 @ v2_b1_s1
let x1_b1_s1 = x0_s1 + o1_b1_s1 @ wo1_1_v0 + o2_b1_s1 @ wo2_1_v0
let u2_b1_s1 = ln_out(x1_b1_s1, g2_1_v0, n2_1_v0)
let pre_b1_s1 = u2_b1_s1 @ w1_1_v0 + c1_1_v0
let r_b1_s1 = relu(pre_b1_s1)
let x2_b1_s1 = x1_b1_s1 + (r_b1_s1 @ w2_1_v0 + c2_1_v0)
let u1_b2_s1 = ln_out(x2_b1_s1, g1_2_v0, n1_2_v0)
let q1_b2_s1 = u1_b2_s1 @ wq1_2_v0
let k1_b2_s1 = u1_b2_s1 @ wk1_2_v0
let v1_b2_s1 = u1_b2_s1 @ wv1_2_v0
let a1_b2_s1 = softmax_rows(q1_b2_s1 @ transpose(k1_b2_s1) * 0.5 + mk)
let o1_b2_s1 = a1_b2_s1 @ v1_b2_s1
let q2_b2_s1 = u1_b2_s1 @ wq2_2_v0
let k2_b2_s1 = u1_b2_s1 @ wk2_2_v0
let v2_b2_s1 = u1_b2_s1 @ wv2_2_v0
let a2_b2_s1 = softmax_rows(q2_b2_s1 @ transpose(k2_b2_s1) * 0.5 + mk)
let o2_b2_s1 = a2_b2_s1 @ v2_b2_s1
let x1_b2_s1 = x2_b1_s1 + o1_b2_s1 @ wo1_2_v0 + o2_b2_s1 @ wo2_2_v0
let u2_b2_s1 = ln_out(x1_b2_s1, g2_2_v0, n2_2_v0)
let pre_b2_s1 = u2_b2_s1 @ w1_2_v0 + c1_2_v0
let r_b2_s1 = relu(pre_b2_s1)
let x2_b2_s1 = x1_b2_s1 + (r_b2_s1 @ w2_2_v0 + c2_2_v0)
