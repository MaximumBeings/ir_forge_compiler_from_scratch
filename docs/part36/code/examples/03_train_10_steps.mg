let c1_1_v1 = c1_1_v0 - Gc1_1_s1 * 0.5
let w2_1_v1 = w2_1_v0 - Gw2_1_s1 * 0.5
let c2_1_v1 = c2_1_v0 - Gc2_1_s1 * 0.5
