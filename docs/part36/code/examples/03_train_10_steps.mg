let wk1_1_v5 = wk1_1_v4 - Gwk1_1_s5 * 0.5
let wv1_1_v5 = wv1_1_v4 - Gwv1_1_s5 * 0.5
let wo1_1_v5 = wo1_1_v4 - Gwo1_1_s5 * 0.5
let wq2_1_v5 = wq2_1_v4 - Gwq2_1_s5 * 0.5
let wk2_1_v5 = wk2_1_v4 - Gwk2_1_s5 * 0.5
let wv2_1_v5 = wv2_1_v4 - Gwv2_1_s5 * 0.5
let wo2_1_v5 = wo2_1_v4 - Gwo2_1_s5 * 0.5
