let q1_b2_s6 = u1_b2_s6 @ wq1_2_v5
let k1_b2_s6 = u1_b2_s6 @ wk1_2_v5
let v1_b2_s6 = u1_b2_s6 @ wv1_2_v5
let a1_b2_s6 = softmax_rows(q1_b2_s6 @ transpose(k1_b2_s6) * 0.5 + mk)
let o1_b2_s6 = a1_b2_s6 @ v1_b2_s6
let q2_b2_s6 = u1_b2_s6 @ wq2_2_v5
let k2_b2_s6 = u1_b2_s6 @ wk2_2_v5
let v2_b2_s6 = u1_b2_s6 @ wv2_2_v5
let a2_b2_s6 = softmax_rows(q2_b2_s6 @ transpose(k2_b2_s6) * 0.5 + mk)
let o2_b2_s6 = a2_b2_s6 @ v2_b2_s6
