let Gwv1_2_s1 = transpose(u1_b2_s1) @ dv1_b2_s1
let Gwo2_2_s1 = transpose(o2_b2_s1) @ dx1_b2_s1
let do2_b2_s1 = dx1_b2_s1 @ transpose(wo2_2_v0)
let dv2_b2_s1 = transpose(a2_b2_s1) @ do2_b2_s1
let da2_b2_s1 = do2_b2_s1 @ transpose(v2_b2_s1)
let ds2_b2_s1 = a2_b2_s1 * (da2_b2_s1 - row_sum(a2_b2_s1 * da2_b2_s1))
