let Gwu_s1 = transpose(uf_s1) @ dl_s1
let duf_s1 = dl_s1 @ transpose(wu_v0)
let Gnf_s1 = col_sum(duf_s1)
let Ggf_s1 = col_sum(duf_s1 * ln_hat(x2_b2_s1))
let dX2_s1 = ln_back(duf_s1, x2_b2_s1, gf_v0)
let Gc2_2_s1 = col_sum(dX2_s1)
let Gw2_2_s1 = transpose(r_b2_s1) @ dX2_s1
let dpre_b2_s1 = (dX2_s1 @ transpose(w2_2_v0)) * ge(pre_b2_s1, [[0]])
let Gc1_2_s1 = col_sum(dpre_b2_s1)
let Gw1_2_s1 = transpose(u2_b2_s1) @ dpre_b2_s1
let du2_b2_s1 = dpre_b2_s1 @ transpose(w1_2_v0)
let Gn2_2_s1 = col_sum(du2_b2_s1)
let Gg2_2_s1 = col_sum(du2_b2_s1 * ln_hat(x1_b2_s1))
