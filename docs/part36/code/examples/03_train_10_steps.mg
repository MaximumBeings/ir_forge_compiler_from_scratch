let c1_2_v1 = c1_2_v0 - Gc1_2_s1 * 0.5
let w2_2_v1 = w2_2_v0 - Gw2_2_s1 * 0.5
let c2_2_v1 = c2_2_v0 - Gc2_2_s1 * 0.5
let gf_v1 = gf_v0 - Ggf_s1 * 0.5
let nf_v1 = nf_v0 - Gnf_s1 * 0.5
let wu_v1 = wu_v0 - Gwu_s1 * 0.5
# ---- step 2: forward pass, backward pass, update
let x0_s2 = x @ e_v1 + ps
let u1_b1_s2 = ln_out(x0_s2, g1_1_v1, n1_1_v1)
let q1_b1_s2 = u1_b1_s2 @ wq1_1_v1
let k1_b1_s2 = u1_b1_s2 @ wk1_1_v1
let v1_b1_s2 = u1_b1_s2 @ wv1_1_v1
let a1_b1_s2 = softmax_rows(q1_b1_s2 @ transpose(k1_b1_s2) * 0.5 + mk)
let o1_b1_s2 = a1_b1_s2 @ v1_b1_s2
let q2_b1_s2 = u1_b1_s2 @ wq2_1_v1
let k2_b1_s2 = u1_b1_s2 @ wk2_1_v1
let v2_b1_s2 = u1_b1_s2 @ wv2_1_v1
let a2_b1_s2 = softmax_rows(q2_b1_s2 @ transpose(k2_b1_s2) * 0.5 + mk)
let o2_b1_s2 = a2_b1_s2 @ v2_b1_s2
let x1_b1_s2 = x0_s2 + o1_b1_s2 @ wo1_1_v1 + o2_b1_s2 @ wo2_1_v1
let u2_b1_s2 = ln_out(x1_b1_s2, g2_1_v1, n2_1_v1)
let pre_b1_s2 = u2_b1_s2 @ w1_1_v1 + c1_1_v1
let r_b1_s2 = relu(pre_b1_s2)
let x2_b1_s2 = x1_b1_s2 + (r_b1_s2 @ w2_1_v1 + c2_1_v1)
let u1_b2_s2 = ln_out(x2_b1_s2, g1_2_v1, n1_2_v1)
let q1_b2_s2 = u1_b2_s2 @ wq1_2_v1
let k1_b2_s2 = u1_b2_s2 @ wk1_2_v1
let v1_b2_s2 = u1_b2_s2 @ wv1_2_v1
let a1_b2_s2 = softmax_rows(q1_b2_s2 @ transpose(k1_b2_s2) * 0.5 + mk)
let o1_b2_s2 = a1_b2_s2 @ v1_b2_s2
let q2_b2_s2 = u1_b2_s2 @ wq2_2_v1
let k2_b2_s2 = u1_b2_s2 @ wk2_2_v1
let v2_b2_s2 = u1_b2_s2 @ wv2_2_v1
let a2_b2_s2 = softmax_rows(q2_b2_s2 @ transpose(k2_b2_s2) * 0.5 + mk)
let o2_b2_s2 = a2_b2_s2 @ v2_b2_s2
let x1_b2_s2 = x2_b1_s2 + o1_b2_s2 @ wo1_2_v1 + o2_b2_s2 @ wo2_2_v1
let u2_b2_s2 = ln_out(x1_b2_s2, g2_2_v1, n2_2_v1)
let pre_b2_s2 = u2_b2_s2 @ w1_2_v1 + c1_2_v1
let r_b2_s2 = relu(pre_b2_s2)
let x2_b2_s2 = x1_b2_s2 + (r_b2_s2 @ w2_2_v1 + c2_2_v1)
let uf_s2 = ln_out(x2_b2_s2, gf_v1, nf_v1)
let lg_s2 = uf_s2 @ wu_v1
let dl_s2 = (exp(log_softmax(lg_s2)) * mr - y) * 0.015625
let Gwu_s2 = transpose(uf_s2) @ dl_s2
let duf_s2 = dl_s2 @ transpose(wu_v1)
let Gnf_s2 = col_sum(duf_s2)
let Ggf_s2 = col_sum(duf_s2 * ln_hat(x2_b2_s2))
let dX2_s2 = ln_back(duf_s2, x2_b2_s2, gf_v1)
let Gc2_2_s2 = col_sum(dX2_s2)
let Gw2_2_s2 = transpose(r_b2_s2) @ dX2_s2
let dpre_b2_s2 = (dX2_s2 @ transpose(w2_2_v1)) * ge(pre_b2_s2, [[0]])
let Gc1_2_s2 = col_sum(dpre_b2_s2)
let Gw1_2_s2 = transpose(u2_b2_s2) @ dpre_b2_s2
let du2_b2_s2 = dpre_b2_s2 @ transpose(w1_2_v1)
let Gn2_2_s2 = col_sum(du2_b2_s2)
let Gg2_2_s2 = col_sum(du2_b2_s2 * ln_hat(x1_b2_s2))
let dx1_b2_s2 = dX2_s2 + ln_back(du2_b2_s2, x1_b2_s2, g2_2_v1)
let Gwo1_2_s2 = transpose(o1_b2_s2) @ dx1_b2_s2
let do1_b2_s2 = dx1_b2_s2 @ transpose(wo1_2_v1)
let dv1_b2_s2 = transpose(a1_b2_s2) @ do1_b2_s2
let da1_b2_s2 = do1_b2_s2 @ transpose(v1_b2_s2)
let ds1_b2_s2 = a1_b2_s2 * (da1_b2_s2 - row_sum(a1_b2_s2 * da1_b2_s2))
let dq1_b2_s2 = ds1_b2_s2 @ k1_b2_s2 * 0.5
let dk1_b2_s2 = transpose(ds1_b2_s2) @ q1_b2_s2 * 0.5
let Gwq1_2_s2 = transpose(u1_b2_s2) @ dq1_b2_s2
let Gwk1_2_s2 = transpose(u1_b2_s2) @ dk1_b2_s2
let Gwv1_2_s2 = transpose(u1_b2_s2) @ dv1_b2_s2
let Gwo2_2_s2 = transpose(o2_b2_s2) @ dx1_b2_s2
let do2_b2_s2 = dx1_b2_s2 @ transpose(wo2_2_v1)
let dv2_b2_s2 = transpose(a2_b2_s2) @ do2_b2_s2
let da2_b2_s2 = do2_b2_s2 @ transpose(v2_b2_s2)
let ds2_b2_s2 = a2_b2_s2 * (da2_b2_s2 - row_sum(a2_b2_s2 * da2_b2_s2))
let dq2_b2_s2 = ds2_b2_s2 @ k2_b2_s2 * 0.5
let dk2_b2_s2 = transpose(ds2_b2_s2) @ q2_b2_s2 * 0.5
let Gwq2_2_s2 = transpose(u1_b2_s2) @ dq2_b2_s2
let Gwk2_2_s2 = transpose(u1_b2_s2) @ dk2_b2_s2
let Gwv2_2_s2 = transpose(u1_b2_s2) @ dv2_b2_s2
let du1_b2_s2 = dq1_b2_s2 @ transpose(wq1_2_v1) + dk1_b2_s2 @ transpose(wk1_2_v1) + dv1_b2_s2 @ transpose(wv1_2_v1) + dq2_b2_s2 @ transpose(wq2_2_v1) + dk2_b2_s2 @ transpose(wk2_2_v1) + dv2_b2_s2 @ transpose(wv2_2_v1)
let Gn1_2_s2 = col_sum(du1_b2_s2)
let Gg1_2_s2 = col_sum(du1_b2_s2 * ln_hat(x2_b1_s2))
let dX1_s2 = dx1_b2_s2 + ln_back(du1_b2_s2, x2_b1_s2, g1_2_v1)
let Gc2_1_s2 = col_sum(dX1_s2)
let Gw2_1_s2 = transpose(r_b1_s2) @ dX1_s2
let dpre_b1_s2 = (dX1_s2 @ transpose(w2_1_v1)) * ge(pre_b1_s2, [[0]])
let Gc1_1_s2 = col_sum(dpre_b1_s2)
let Gw1_1_s2 = transpose(u2_b1_s2) @ dpre_b1_s2
let du2_b1_s2 = dpre_b1_s2 @ transpose(w1_1_v1)
let Gn2_1_s2 = col_sum(du2_b1_s2)
let Gg2_1_s2 = col_sum(du2_b1_s2 * ln_hat(x1_b1_s2))
let dx1_b1_s2 = dX1_s2 + ln_back(du2_b1_s2, x1_b1_s2, g2_1_v1)
let Gwo1_1_s2 = transpose(o1_b1_s2) @ dx1_b1_s2
let do1_b1_s2 = dx1_b1_s2 @ transpose(wo1_1_v1)
let dv1_b1_s2 = transpose(a1_b1_s2) @ do1_b1_s2
let da1_b1_s2 = do1_b1_s2 @ transpose(v1_b1_s2)
let ds1_b1_s2 = a1_b1_s2 * (da1_b1_s2 - row_sum(a1_b1_s2 * da1_b1_s2))
let dq1_b1_s2 = ds1_b1_s2 @ k1_b1_s2 * 0.5
let dk1_b1_s2 = transpose(ds1_b1_s2) @ q1_b1_s2 * 0.5
let Gwq1_1_s2 = transpose(u1_b1_s2) @ dq1_b1_s2
let Gwk1_1_s2 = transpose(u1_b1_s2) @ dk1_b1_s2
let Gwv1_1_s2 = transpose(u1_b1_s2) @ dv1_b1_s2
let Gwo2_1_s2 = transpose(o2_b1_s2) @ dx1_b1_s2
let do2_b1_s2 = dx1_b1_s2 @ transpose(wo2_1_v1)
let dv2_b1_s2 = transpose(a2_b1_s2) @ do2_b1_s2
let da2_b1_s2 = do2_b1_s2 @ transpose(v2_b1_s2)
let ds2_b1_s2 = a2_b1_s2 * (da2_b1_s2 - row_sum(a2_b1_s2 * da2_b1_s2))
let dq2_b1_s2 = ds2_b1_s2 @ k2_b1_s2 * 0.5
let dk2_b1_s2 = transpose(ds2_b1_s2) @ q2_b1_s2 * 0.5
let Gwq2_1_s2 = transpose(u1_b1_s2) @ dq2_b1_s2
let Gwk2_1_s2 = transpose(u1_b1_s2) @ dk2_b1_s2
let Gwv2_1_s2 = transpose(u1_b1_s2) @ dv2_b1_s2
let du1_b1_s2 = dq1_b1_s2 @ transpose(wq1_1_v1) + dk1_b1_s2 @ transpose(wk1_1_v1) + dv1_b1_s2 @ transpose(wv1_1_v1) + dq2_b1_s2 @ transpose(wq2_1_v1) + dk2_b1_s2 @ transpose(wk2_1_v1) + dv2_b1_s2 @ transpose(wv2_1_v1)
let Gn1_1_s2 = col_sum(du1_b1_s2)
let Gg1_1_s2 = col_sum(du1_b1_s2 * ln_hat(x0_s2))
let dX0_s2 = dx1_b1_s2 + ln_back(du1_b1_s2, x0_s2, g1_1_v1)
let Ge_s2 = transpose(x) @ dX0_s2
let e_v2 = e_v1 - Ge_s2 * 0.5
let g1_1_v2 = g1_1_v1 - Gg1_1_s2 * 0.5
let n1_1_v2 = n1_1_v1 - Gn1_1_s2 * 0.5
let wq1_1_v2 = wq1_1_v1 - Gwq1_1_s2 * 0.5
let wk1_1_v2 = wk1_1_v1 - Gwk1_1_s2 * 0.5
let wv1_1_v2 = wv1_1_v1 - Gwv1_1_s2 * 0.5
let wo1_1_v2 = wo1_1_v1 - Gwo1_1_s2 * 0.5
let wq2_1_v2 = wq2_1_v1 - Gwq2_1_s2 * 0.5
let wk2_1_v2 = wk2_1_v1 - Gwk2_1_s2 * 0.5
let wv2_1_v2 = wv2_1_v1 - Gwv2_1_s2 * 0.5
let wo2_1_v2 = wo2_1_v1 - Gwo2_1_s2 * 0.5
let g2_1_v2 = g2_1_v1 - Gg2_1_s2 * 0.5
let n2_1_v2 = n2_1_v1 - Gn2_1_s2 * 0.5
let w1_1_v2 = w1_1_v1 - Gw1_1_s2 * 0.5
let c1_1_v2 = c1_1_v1 - Gc1_1_s2 * 0.5
let w2_1_v2 = w2_1_v1 - Gw2_1_s2 * 0.5
let c2_1_v2 = c2_1_v1 - Gc2_1_s2 * 0.5
let g1_2_v2 = g1_2_v1 - Gg1_2_s2 * 0.5
let n1_2_v2 = n1_2_v1 - Gn1_2_s2 * 0.5
let wq1_2_v2 = wq1_2_v1 - Gwq1_2_s2 * 0.5
let wk1_2_v2 = wk1_2_v1 - Gwk1_2_s2 * 0.5
let wv1_2_v2 = wv1_2_v1 - Gwv1_2_s2 * 0.5
let wo1_2_v2 = wo1_2_v1 - Gwo1_2_s2 * 0.5
let wq2_2_v2 = wq2_2_v1 - Gwq2_2_s2 * 0.5
let wk2_2_v2 = wk2_2_v1 - Gwk2_2_s2 * 0.5
let wv2_2_v2 = wv2_2_v1 - Gwv2_2_s2 * 0.5
let wo2_2_v2 = wo2_2_v1 - Gwo2_2_s2 * 0.5
let g2_2_v2 = g2_2_v1 - Gg2_2_s2 * 0.5
let n2_2_v2 = n2_2_v1 - Gn2_2_s2 * 0.5
let w1_2_v2 = w1_2_v1 - Gw1_2_s2 * 0.5
let c1_2_v2 = c1_2_v1 - Gc1_2_s2 * 0.5
let w2_2_v2 = w2_2_v1 - Gw2_2_s2 * 0.5
let c2_2_v2 = c2_2_v1 - Gc2_2_s2 * 0.5
let gf_v2 = gf_v1 - Ggf_s2 * 0.5
let nf_v2 = nf_v1 - Gnf_s2 * 0.5
let wu_v2 = wu_v1 - Gwu_s2 * 0.5
# ---- step 3: forward pass, backward pass, update
let x0_s3 = x @ e_v2 + ps
let u1_b1_s3 = ln_out(x0_s3, g1_1_v2, n1_1_v2)
let q1_b1_s3 = u1_b1_s3 @ wq1_1_v2
let k1_b1_s3 = u1_b1_s3 @ wk1_1_v2
let v1_b1_s3 = u1_b1_s3 @ wv1_1_v2
let a1_b1_s3 = softmax_rows(q1_b1_s3 @ transpose(k1_b1_s3) * 0.5 + mk)
let o1_b1_s3 = a1_b1_s3 @ v1_b1_s3
let q2_b1_s3 = u1_b1_s3 @ wq2_1_v2
let k2_b1_s3 = u1_b1_s3 @ wk2_1_v2
let v2_b1_s3 = u1_b1_s3 @ wv2_1_v2
let a2_b1_s3 = softmax_rows(q2_b1_s3 @ transpose(k2_b1_s3) * 0.5 + mk)
let o2_b1_s3 = a2_b1_s3 @ v2_b1_s3
let x1_b1_s3 = x0_s3 + o1_b1_s3 @ wo1_1_v2 + o2_b1_s3 @ wo2_1_v2
let u2_b1_s3 = ln_out(x1_b1_s3, g2_1_v2, n2_1_v2)
let pre_b1_s3 = u2_b1_s3 @ w1_1_v2 + c1_1_v2
let r_b1_s3 = relu(pre_b1_s3)
let x2_b1_s3 = x1_b1_s3 + (r_b1_s3 @ w2_1_v2 + c2_1_v2)
let u1_b2_s3 = ln_out(x2_b1_s3, g1_2_v2, n1_2_v2)
let q1_b2_s3 = u1_b2_s3 @ wq1_2_v2
let k1_b2_s3 = u1_b2_s3 @ wk1_2_v2
let v1_b2_s3 = u1_b2_s3 @ wv1_2_v2
let a1_b2_s3 = softmax_rows(q1_b2_s3 @ transpose(k1_b2_s3) * 0.5 + mk)
let o1_b2_s3 = a1_b2_s3 @ v1_b2_s3
let q2_b2_s3 = u1_b2_s3 @ wq2_2_v2
let k2_b2_s3 = u1_b2_s3 @ wk2_2_v2
let v2_b2_s3 = u1_b2_s3 @ wv2_2_v2
let a2_b2_s3 = softmax_rows(q2_b2_s3 @ transpose(k2_b2_s3) * 0.5 + mk)
let o2_b2_s3 = a2_b2_s3 @ v2_b2_s3
let x1_b2_s3 = x2_b1_s3 + o1_b2_s3 @ wo1_2_v2 + o2_b2_s3 @ wo2_2_v2
let u2_b2_s3 = ln_out(x1_b2_s3, g2_2_v2, n2_2_v2)
let pre_b2_s3 = u2_b2_s3 @ w1_2_v2 + c1_2_v2
let r_b2_s3 = relu(pre_b2_s3)
let x2_b2_s3 = x1_b2_s3 + (r_b2_s3 @ w2_2_v2 + c2_2_v2)
let uf_s3 = ln_out(x2_b2_s3, gf_v2, nf_v2)
let lg_s3 = uf_s3 @ wu_v2
let dl_s3 = (exp(log_softmax(lg_s3)) * mr - y) * 0.015625
let Gwu_s3 = transpose(uf_s3) @ dl_s3
let duf_s3 = dl_s3 @ transpose(wu_v2)
let Gnf_s3 = col_sum(duf_s3)
let Ggf_s3 = col_sum(duf_s3 * ln_hat(x2_b2_s3))
let dX2_s3 = ln_back(duf_s3, x2_b2_s3, gf_v2)
let Gc2_2_s3 = col_sum(dX2_s3)
let Gw2_2_s3 = transpose(r_b2_s3) @ dX2_s3
let dpre_b2_s3 = (dX2_s3 @ transpose(w2_2_v2)) * ge(pre_b2_s3, [[0]])
let Gc1_2_s3 = col_sum(dpre_b2_s3)
let Gw1_2_s3 = transpose(u2_b2_s3) @ dpre_b2_s3
let du2_b2_s3 = dpre_b2_s3 @ transpose(w1_2_v2)
let Gn2_2_s3 = col_sum(du2_b2_s3)
let Gg2_2_s3 = col_sum(du2_b2_s3 * ln_hat(x1_b2_s3))
let dx1_b2_s3 = dX2_s3 + ln_back(du2_b2_s3, x1_b2_s3, g2_2_v2)
let Gwo1_2_s3 = transpose(o1_b2_s3) @ dx1_b2_s3
let do1_b2_s3 = dx1_b2_s3 @ transpose(wo1_2_v2)
let dv1_b2_s3 = transpose(a1_b2_s3) @ do1_b2_s3
let da1_b2_s3 = do1_b2_s3 @ transpose(v1_b2_s3)
let ds1_b2_s3 = a1_b2_s3 * (da1_b2_s3 - row_sum(a1_b2_s3 * da1_b2_s3))
let dq1_b2_s3 = ds1_b2_s3 @ k1_b2_s3 * 0.5
let dk1_b2_s3 = transpose(ds1_b2_s3) @ q1_b2_s3 * 0.5
let Gwq1_2_s3 = transpose(u1_b2_s3) @ dq1_b2_s3
let Gwk1_2_s3 = transpose(u1_b2_s3) @ dk1_b2_s3
let Gwv1_2_s3 = transpose(u1_b2_s3) @ dv1_b2_s3
let Gwo2_2_s3 = transpose(o2_b2_s3) @ dx1_b2_s3
let do2_b2_s3 = dx1_b2_s3 @ transpose(wo2_2_v2)
let dv2_b2_s3 = transpose(a2_b2_s3) @ do2_b2_s3
let da2_b2_s3 = do2_b2_s3 @ transpose(v2_b2_s3)
let ds2_b2_s3 = a2_b2_s3 * (da2_b2_s3 - row_sum(a2_b2_s3 * da2_b2_s3))
let dq2_b2_s3 = ds2_b2_s3 @ k2_b2_s3 * 0.5
let dk2_b2_s3 = transpose(ds2_b2_s3) @ q2_b2_s3 * 0.5
let Gwq2_2_s3 = transpose(u1_b2_s3) @ dq2_b2_s3
let Gwk2_2_s3 = transpose(u1_b2_s3) @ dk2_b2_s3
let Gwv2_2_s3 = transpose(u1_b2_s3) @ dv2_b2_s3
let du1_b2_s3 = dq1_b2_s3 @ transpose(wq1_2_v2) + dk1_b2_s3 @ transpose(wk1_2_v2) + dv1_b2_s3 @ transpose(wv1_2_v2) + dq2_b2_s3 @ transpose(wq2_2_v2) + dk2_b2_s3 @ transpose(wk2_2_v2) + dv2_b2_s3 @ transpose(wv2_2_v2)
let Gn1_2_s3 = col_sum(du1_b2_s3)
let Gg1_2_s3 = col_sum(du1_b2_s3 * ln_hat(x2_b1_s3))
let dX1_s3 = dx1_b2_s3 + ln_back(du1_b2_s3, x2_b1_s3, g1_2_v2)
let Gc2_1_s3 = col_sum(dX1_s3)
let Gw2_1_s3 = transpose(r_b1_s3) @ dX1_s3
let dpre_b1_s3 = (dX1_s3 @ transpose(w2_1_v2)) * ge(pre_b1_s3, [[0]])
let Gc1_1_s3 = col_sum(dpre_b1_s3)
let Gw1_1_s3 = transpose(u2_b1_s3) @ dpre_b1_s3
let du2_b1_s3 = dpre_b1_s3 @ transpose(w1_1_v2)
let Gn2_1_s3 = col_sum(du2_b1_s3)
let Gg2_1_s3 = col_sum(du2_b1_s3 * ln_hat(x1_b1_s3))
let dx1_b1_s3 = dX1_s3 + ln_back(du2_b1_s3, x1_b1_s3, g2_1_v2)
let Gwo1_1_s3 = transpose(o1_b1_s3) @ dx1_b1_s3
let do1_b1_s3 = dx1_b1_s3 @ transpose(wo1_1_v2)
let dv1_b1_s3 = transpose(a1_b1_s3) @ do1_b1_s3
let da1_b1_s3 = do1_b1_s3 @ transpose(v1_b1_s3)
let ds1_b1_s3 = a1_b1_s3 * (da1_b1_s3 - row_sum(a1_b1_s3 * da1_b1_s3))
let dq1_b1_s3 = ds1_b1_s3 @ k1_b1_s3 * 0.5
let dk1_b1_s3 = transpose(ds1_b1_s3) @ q1_b1_s3 * 0.5
let Gwq1_1_s3 = transpose(u1_b1_s3) @ dq1_b1_s3
let Gwk1_1_s3 = transpose(u1_b1_s3) @ dk1_b1_s3
let Gwv1_1_s3 = transpose(u1_b1_s3) @ dv1_b1_s3
let Gwo2_1_s3 = transpose(o2_b1_s3) @ dx1_b1_s3
let do2_b1_s3 = dx1_b1_s3 @ transpose(wo2_1_v2)
let dv2_b1_s3 = transpose(a2_b1_s3) @ do2_b1_s3
let da2_b1_s3 = do2_b1_s3 @ transpose(v2_b1_s3)
let ds2_b1_s3 = a2_b1_s3 * (da2_b1_s3 - row_sum(a2_b1_s3 * da2_b1_s3))
let dq2_b1_s3 = ds2_b1_s3 @ k2_b1_s3 * 0.5
let dk2_b1_s3 = transpose(ds2_b1_s3) @ q2_b1_s3 * 0.5
let Gwq2_1_s3 = transpose(u1_b1_s3) @ dq2_b1_s3
let Gwk2_1_s3 = transpose(u1_b1_s3) @ dk2_b1_s3
let Gwv2_1_s3 = transpose(u1_b1_s3) @ dv2_b1_s3
let du1_b1_s3 = dq1_b1_s3 @ transpose(wq1_1_v2) + dk1_b1_s3 @ transpose(wk1_1_v2) + dv1_b1_s3 @ transpose(wv1_1_v2) + dq2_b1_s3 @ transpose(wq2_1_v2) + dk2_b1_s3 @ transpose(wk2_1_v2) + dv2_b1_s3 @ transpose(wv2_1_v2)
let Gn1_1_s3 = col_sum(du1_b1_s3)
let Gg1_1_s3 = col_sum(du1_b1_s3 * ln_hat(x0_s3))
let dX0_s3 = dx1_b1_s3 + ln_back(du1_b1_s3, x0_s3, g1_1_v2)
let Ge_s3 = transpose(x) @ dX0_s3
let e_v3 = e_v2 - Ge_s3 * 0.5
let g1_1_v3 = g1_1_v2 - Gg1_1_s3 * 0.5
let n1_1_v3 = n1_1_v2 - Gn1_1_s3 * 0.5
let wq1_1_v3 = wq1_1_v2 - Gwq1_1_s3 * 0.5
let wk1_1_v3 = wk1_1_v2 - Gwk1_1_s3 * 0.5
let wv1_1_v3 = wv1_1_v2 - Gwv1_1_s3 * 0.5
let wo1_1_v3 = wo1_1_v2 - Gwo1_1_s3 * 0.5
let wq2_1_v3 = wq2_1_v2 - Gwq2_1_s3 * 0.5
let wk2_1_v3 = wk2_1_v2 - Gwk2_1_s3 * 0.5
let wv2_1_v3 = wv2_1_v2 - Gwv2_1_s3 * 0.5
let wo2_1_v3 = wo2_1_v2 - Gwo2_1_s3 * 0.5
let g2_1_v3 = g2_1_v2 - Gg2_1_s3 * 0.5
let n2_1_v3 = n2_1_v2 - Gn2_1_s3 * 0.5
let w1_1_v3 = w1_1_v2 - Gw1_1_s3 * 0.5
let c1_1_v3 = c1_1_v2 - Gc1_1_s3 * 0.5
let w2_1_v3 = w2_1_v2 - Gw2_1_s3 * 0.5
let c2_1_v3 = c2_1_v2 - Gc2_1_s3 * 0.5
let g1_2_v3 = g1_2_v2 - Gg1_2_s3 * 0.5
let n1_2_v3 = n1_2_v2 - Gn1_2_s3 * 0.5
let wq1_2_v3 = wq1_2_v2 - Gwq1_2_s3 * 0.5
let wk1_2_v3 = wk1_2_v2 - Gwk1_2_s3 * 0.5
let wv1_2_v3 = wv1_2_v2 - Gwv1_2_s3 * 0.5
let wo1_2_v3 = wo1_2_v2 - Gwo1_2_s3 * 0.5
let wq2_2_v3 = wq2_2_v2 - Gwq2_2_s3 * 0.5
let wk2_2_v3 = wk2_2_v2 - Gwk2_2_s3 * 0.5
let wv2_2_v3 = wv2_2_v2 - Gwv2_2_s3 * 0.5
let wo2_2_v3 = wo2_2_v2 - Gwo2_2_s3 * 0.5
let g2_2_v3 = g2_2_v2 - Gg2_2_s3 * 0.5
let n2_2_v3 = n2_2_v2 - Gn2_2_s3 * 0.5
let w1_2_v3 = w1_2_v2 - Gw1_2_s3 * 0.5
let c1_2_v3 = c1_2_v2 - Gc1_2_s3 * 0.5
let w2_2_v3 = w2_2_v2 - Gw2_2_s3 * 0.5
let c2_2_v3 = c2_2_v2 - Gc2_2_s3 * 0.5
let gf_v3 = gf_v2 - Ggf_s3 * 0.5
let nf_v3 = nf_v2 - Gnf_s3 * 0.5
let wu_v3 = wu_v2 - Gwu_s3 * 0.5
# ---- step 4: forward pass, backward pass, update
let x0_s4 = x @ e_v3 + ps
let u1_b1_s4 = ln_out(x0_s4, g1_1_v3, n1_1_v3)
let q1_b1_s4 = u1_b1_s4 @ wq1_1_v3
let k1_b1_s4 = u1_b1_s4 @ wk1_1_v3
let v1_b1_s4 = u1_b1_s4 @ wv1_1_v3
let a1_b1_s4 = softmax_rows(q1_b1_s4 @ transpose(k1_b1_s4) * 0.5 + mk)
let o1_b1_s4 = a1_b1_s4 @ v1_b1_s4
let q2_b1_s4 = u1_b1_s4 @ wq2_1_v3
let k2_b1_s4 = u1_b1_s4 @ wk2_1_v3
let v2_b1_s4 = u1_b1_s4 @ wv2_1_v3
let a2_b1_s4 = softmax_rows(q2_b1_s4 @ transpose(k2_b1_s4) * 0.5 + mk)
let o2_b1_s4 = a2_b1_s4 @ v2_b1_s4
let x1_b1_s4 = x0_s4 + o1_b1_s4 @ wo1_1_v3 + o2_b1_s4 @ wo2_1_v3
let u2_b1_s4 = ln_out(x1_b1_s4, g2_1_v3, n2_1_v3)
let pre_b1_s4 = u2_b1_s4 @ w1_1_v3 + c1_1_v3
let r_b1_s4 = relu(pre_b1_s4)
let x2_b1_s4 = x1_b1_s4 + (r_b1_s4 @ w2_1_v3 + c2_1_v3)
let u1_b2_s4 = ln_out(x2_b1_s4, g1_2_v3, n1_2_v3)
let q1_b2_s4 = u1_b2_s4 @ wq1_2_v3
let k1_b2_s4 = u1_b2_s4 @ wk1_2_v3
let v1_b2_s4 = u1_b2_s4 @ wv1_2_v3
let a1_b2_s4 = softmax_rows(q1_b2_s4 @ transpose(k1_b2_s4) * 0.5 + mk)
let o1_b2_s4 = a1_b2_s4 @ v1_b2_s4
let q2_b2_s4 = u1_b2_s4 @ wq2_2_v3
let k2_b2_s4 = u1_b2_s4 @ wk2_2_v3
let v2_b2_s4 = u1_b2_s4 @ wv2_2_v3
let a2_b2_s4 = softmax_rows(q2_b2_s4 @ transpose(k2_b2_s4) * 0.5 + mk)
let o2_b2_s4 = a2_b2_s4 @ v2_b2_s4
let x1_b2_s4 = x2_b1_s4 + o1_b2_s4 @ wo1_2_v3 + o2_b2_s4 @ wo2_2_v3
let u2_b2_s4 = ln_out(x1_b2_s4, g2_2_v3, n2_2_v3)
let pre_b2_s4 = u2_b2_s4 @ w1_2_v3 + c1_2_v3
let r_b2_s4 = relu(pre_b2_s4)
let x2_b2_s4 = x1_b2_s4 + (r_b2_s4 @ w2_2_v3 + c2_2_v3)
let uf_s4 = ln_out(x2_b2_s4, gf_v3, nf_v3)
let lg_s4 = uf_s4 @ wu_v3
let dl_s4 = (exp(log_softmax(lg_s4)) * mr - y) * 0.015625
let Gwu_s4 = transpose(uf_s4) @ dl_s4
let duf_s4 = dl_s4 @ transpose(wu_v3)
let Gnf_s4 = col_sum(duf_s4)
let Ggf_s4 = col_sum(duf_s4 * ln_hat(x2_b2_s4))
let dX2_s4 = ln_back(duf_s4, x2_b2_s4, gf_v3)
let Gc2_2_s4 = col_sum(dX2_s4)
let Gw2_2_s4 = transpose(r_b2_s4) @ dX2_s4
let dpre_b2_s4 = (dX2_s4 @ transpose(w2_2_v3)) * ge(pre_b2_s4, [[0]])
let Gc1_2_s4 = col_sum(dpre_b2_s4)
let Gw1_2_s4 = transpose(u2_b2_s4) @ dpre_b2_s4
let du2_b2_s4 = dpre_b2_s4 @ transpose(w1_2_v3)
let Gn2_2_s4 = col_sum(du2_b2_s4)
let Gg2_2_s4 = col_sum(du2_b2_s4 * ln_hat(x1_b2_s4))
let dx1_b2_s4 = dX2_s4 + ln_back(du2_b2_s4, x1_b2_s4, g2_2_v3)
let Gwo1_2_s4 = transpose(o1_b2_s4) @ dx1_b2_s4
let do1_b2_s4 = dx1_b2_s4 @ transpose(wo1_2_v3)
let dv1_b2_s4 = transpose(a1_b2_s4) @ do1_b2_s4
let da1_b2_s4 = do1_b2_s4 @ transpose(v1_b2_s4)
let ds1_b2_s4 = a1_b2_s4 * (da1_b2_s4 - row_sum(a1_b2_s4 * da1_b2_s4))
let dq1_b2_s4 = ds1_b2_s4 @ k1_b2_s4 * 0.5
let dk1_b2_s4 = transpose(ds1_b2_s4) @ q1_b2_s4 * 0.5
let Gwq1_2_s4 = transpose(u1_b2_s4) @ dq1_b2_s4
let Gwk1_2_s4 = transpose(u1_b2_s4) @ dk1_b2_s4
let Gwv1_2_s4 = transpose(u1_b2_s4) @ dv1_b2_s4
let Gwo2_2_s4 = transpose(o2_b2_s4) @ dx1_b2_s4
let do2_b2_s4 = dx1_b2_s4 @ transpose(wo2_2_v3)
let dv2_b2_s4 = transpose(a2_b2_s4) @ do2_b2_s4
let da2_b2_s4 = do2_b2_s4 @ transpose(v2_b2_s4)
let ds2_b2_s4 = a2_b2_s4 * (da2_b2_s4 - row_sum(a2_b2_s4 * da2_b2_s4))
let dq2_b2_s4 = ds2_b2_s4 @ k2_b2_s4 * 0.5
let dk2_b2_s4 = transpose(ds2_b2_s4) @ q2_b2_s4 * 0.5
let Gwq2_2_s4 = transpose(u1_b2_s4) @ dq2_b2_s4
let Gwk2_2_s4 = transpose(u1_b2_s4) @ dk2_b2_s4
let Gwv2_2_s4 = transpose(u1_b2_s4) @ dv2_b2_s4
let du1_b2_s4 = dq1_b2_s4 @ transpose(wq1_2_v3) + dk1_b2_s4 @ transpose(wk1_2_v3) + dv1_b2_s4 @ transpose(wv1_2_v3) + dq2_b2_s4 @ transpose(wq2_2_v3) + dk2_b2_s4 @ transpose(wk2_2_v3) + dv2_b2_s4 @ transpose(wv2_2_v3)
let Gn1_2_s4 = col_sum(du1_b2_s4)
let Gg1_2_s4 = col_sum(du1_b2_s4 * ln_hat(x2_b1_s4))
let dX1_s4 = dx1_b2_s4 + ln_back(du1_b2_s4, x2_b1_s4, g1_2_v3)
let Gc2_1_s4 = col_sum(dX1_s4)
let Gw2_1_s4 = transpose(r_b1_s4) @ dX1_s4
let dpre_b1_s4 = (dX1_s4 @ transpose(w2_1_v3)) * ge(pre_b1_s4, [[0]])
let Gc1_1_s4 = col_sum(dpre_b1_s4)
let Gw1_1_s4 = transpose(u2_b1_s4) @ dpre_b1_s4
let du2_b1_s4 = dpre_b1_s4 @ transpose(w1_1_v3)
let Gn2_1_s4 = col_sum(du2_b1_s4)
let Gg2_1_s4 = col_sum(du2_b1_s4 * ln_hat(x1_b1_s4))
let dx1_b1_s4 = dX1_s4 + ln_back(du2_b1_s4, x1_b1_s4, g2_1_v3)
let Gwo1_1_s4 = transpose(o1_b1_s4) @ dx1_b1_s4
let do1_b1_s4 = dx1_b1_s4 @ transpose(wo1_1_v3)
let dv1_b1_s4 = transpose(a1_b1_s4) @ do1_b1_s4
let da1_b1_s4 = do1_b1_s4 @ transpose(v1_b1_s4)
let ds1_b1_s4 = a1_b1_s4 * (da1_b1_s4 - row_sum(a1_b1_s4 * da1_b1_s4))
let dq1_b1_s4 = ds1_b1_s4 @ k1_b1_s4 * 0.5
let dk1_b1_s4 = transpose(ds1_b1_s4) @ q1_b1_s4 * 0.5
let Gwq1_1_s4 = transpose(u1_b1_s4) @ dq1_b1_s4
let Gwk1_1_s4 = transpose(u1_b1_s4) @ dk1_b1_s4
let Gwv1_1_s4 = transpose(u1_b1_s4) @ dv1_b1_s4
let Gwo2_1_s4 = transpose(o2_b1_s4) @ dx1_b1_s4
let do2_b1_s4 = dx1_b1_s4 @ transpose(wo2_1_v3)
let dv2_b1_s4 = transpose(a2_b1_s4) @ do2_b1_s4
let da2_b1_s4 = do2_b1_s4 @ transpose(v2_b1_s4)
let ds2_b1_s4 = a2_b1_s4 * (da2_b1_s4 - row_sum(a2_b1_s4 * da2_b1_s4))
let dq2_b1_s4 = ds2_b1_s4 @ k2_b1_s4 * 0.5
let dk2_b1_s4 = transpose(ds2_b1_s4) @ q2_b1_s4 * 0.5
let Gwq2_1_s4 = transpose(u1_b1_s4) @ dq2_b1_s4
let Gwk2_1_s4 = transpose(u1_b1_s4) @ dk2_b1_s4
let Gwv2_1_s4 = transpose(u1_b1_s4) @ dv2_b1_s4
let du1_b1_s4 = dq1_b1_s4 @ transpose(wq1_1_v3) + dk1_b1_s4 @ transpose(wk1_1_v3) + dv1_b1_s4 @ transpose(wv1_1_v3) + dq2_b1_s4 @ transpose(wq2_1_v3) + dk2_b1_s4 @ transpose(wk2_1_v3) + dv2_b1_s4 @ transpose(wv2_1_v3)
let Gn1_1_s4 = col_sum(du1_b1_s4)
let Gg1_1_s4 = col_sum(du1_b1_s4 * ln_hat(x0_s4))
let dX0_s4 = dx1_b1_s4 + ln_back(du1_b1_s4, x0_s4, g1_1_v3)
let Ge_s4 = transpose(x) @ dX0_s4
let e_v4 = e_v3 - Ge_s4 * 0.5
let g1_1_v4 = g1_1_v3 - Gg1_1_s4 * 0.5
let n1_1_v4 = n1_1_v3 - Gn1_1_s4 * 0.5
let wq1_1_v4 = wq1_1_v3 - Gwq1_1_s4 * 0.5
let wk1_1_v4 = wk1_1_v3 - Gwk1_1_s4 * 0.5
let wv1_1_v4 = wv1_1_v3 - Gwv1_1_s4 * 0.5
let wo1_1_v4 = wo1_1_v3 - Gwo1_1_s4 * 0.5
let wq2_1_v4 = wq2_1_v3 - Gwq2_1_s4 * 0.5
let wk2_1_v4 = wk2_1_v3 - Gwk2_1_s4 * 0.5
let wv2_1_v4 = wv2_1_v3 - Gwv2_1_s4 * 0.5
let wo2_1_v4 = wo2_1_v3 - Gwo2_1_s4 * 0.5
let g2_1_v4 = g2_1_v3 - Gg2_1_s4 * 0.5
let n2_1_v4 = n2_1_v3 - Gn2_1_s4 * 0.5
let w1_1_v4 = w1_1_v3 - Gw1_1_s4 * 0.5
let c1_1_v4 = c1_1_v3 - Gc1_1_s4 * 0.5
let w2_1_v4 = w2_1_v3 - Gw2_1_s4 * 0.5
let c2_1_v4 = c2_1_v3 - Gc2_1_s4 * 0.5
let g1_2_v4 = g1_2_v3 - Gg1_2_s4 * 0.5
let n1_2_v4 = n1_2_v3 - Gn1_2_s4 * 0.5
let wq1_2_v4 = wq1_2_v3 - Gwq1_2_s4 * 0.5
let wk1_2_v4 = wk1_2_v3 - Gwk1_2_s4 * 0.5
let wv1_2_v4 = wv1_2_v3 - Gwv1_2_s4 * 0.5
let wo1_2_v4 = wo1_2_v3 - Gwo1_2_s4 * 0.5
let wq2_2_v4 = wq2_2_v3 - Gwq2_2_s4 * 0.5
let wk2_2_v4 = wk2_2_v3 - Gwk2_2_s4 * 0.5
let wv2_2_v4 = wv2_2_v3 - Gwv2_2_s4 * 0.5
let wo2_2_v4 = wo2_2_v3 - Gwo2_2_s4 * 0.5
let g2_2_v4 = g2_2_v3 - Gg2_2_s4 * 0.5
let n2_2_v4 = n2_2_v3 - Gn2_2_s4 * 0.5
let w1_2_v4 = w1_2_v3 - Gw1_2_s4 * 0.5
let c1_2_v4 = c1_2_v3 - Gc1_2_s4 * 0.5
let w2_2_v4 = w2_2_v3 - Gw2_2_s4 * 0.5
let c2_2_v4 = c2_2_v3 - Gc2_2_s4 * 0.5
let gf_v4 = gf_v3 - Ggf_s4 * 0.5
let nf_v4 = nf_v3 - Gnf_s4 * 0.5
let wu_v4 = wu_v3 - Gwu_s4 * 0.5
# ---- step 5: forward pass, backward pass, update
let x0_s5 = x @ e_v4 + ps
let u1_b1_s5 = ln_out(x0_s5, g1_1_v4, n1_1_v4)
let q1_b1_s5 = u1_b1_s5 @ wq1_1_v4
let k1_b1_s5 = u1_b1_s5 @ wk1_1_v4
let v1_b1_s5 = u1_b1_s5 @ wv1_1_v4
let a1_b1_s5 = softmax_rows(q1_b1_s5 @ transpose(k1_b1_s5) * 0.5 + mk)
let o1_b1_s5 = a1_b1_s5 @ v1_b1_s5
let q2_b1_s5 = u1_b1_s5 @ wq2_1_v4
let k2_b1_s5 = u1_b1_s5 @ wk2_1_v4
let v2_b1_s5 = u1_b1_s5 @ wv2_1_v4
let a2_b1_s5 = softmax_rows(q2_b1_s5 @ transpose(k2_b1_s5) * 0.5 + mk)
let o2_b1_s5 = a2_b1_s5 @ v2_b1_s5
let x1_b1_s5 = x0_s5 + o1_b1_s5 @ wo1_1_v4 + o2_b1_s5 @ wo2_1_v4
let u2_b1_s5 = ln_out(x1_b1_s5, g2_1_v4, n2_1_v4)
let pre_b1_s5 = u2_b1_s5 @ w1_1_v4 + c1_1_v4
let r_b1_s5 = relu(pre_b1_s5)
let x2_b1_s5 = x1_b1_s5 + (r_b1_s5 @ w2_1_v4 + c2_1_v4)
let u1_b2_s5 = ln_out(x2_b1_s5, g1_2_v4, n1_2_v4)
let q1_b2_s5 = u1_b2_s5 @ wq1_2_v4
let k1_b2_s5 = u1_b2_s5 @ wk1_2_v4
let v1_b2_s5 = u1_b2_s5 @ wv1_2_v4
let a1_b2_s5 = softmax_rows(q1_b2_s5 @ transpose(k1_b2_s5) * 0.5 + mk)
let o1_b2_s5 = a1_b2_s5 @ v1_b2_s5
let q2_b2_s5 = u1_b2_s5 @ wq2_2_v4
let k2_b2_s5 = u1_b2_s5 @ wk2_2_v4
let v2_b2_s5 = u1_b2_s5 @ wv2_2_v4
let a2_b2_s5 = softmax_rows(q2_b2_s5 @ transpose(k2_b2_s5) * 0.5 + mk)
let o2_b2_s5 = a2_b2_s5 @ v2_b2_s5
let x1_b2_s5 = x2_b1_s5 + o1_b2_s5 @ wo1_2_v4 + o2_b2_s5 @ wo2_2_v4
let u2_b2_s5 = ln_out(x1_b2_s5, g2_2_v4, n2_2_v4)
let pre_b2_s5 = u2_b2_s5 @ w1_2_v4 + c1_2_v4
let r_b2_s5 = relu(pre_b2_s5)
let x2_b2_s5 = x1_b2_s5 + (r_b2_s5 @ w2_2_v4 + c2_2_v4)
let uf_s5 = ln_out(x2_b2_s5, gf_v4, nf_v4)
let lg_s5 = uf_s5 @ wu_v4
let dl_s5 = (exp(log_softmax(lg_s5)) * mr - y) * 0.015625
let Gwu_s5 = transpose(uf_s5) @ dl_s5
let duf_s5 = dl_s5 @ transpose(wu_v4)
let Gnf_s5 = col_sum(duf_s5)
let Ggf_s5 = col_sum(duf_s5 * ln_hat(x2_b2_s5))
let dX2_s5 = ln_back(duf_s5, x2_b2_s5, gf_v4)
let Gc2_2_s5 = col_sum(dX2_s5)
let Gw2_2_s5 = transpose(r_b2_s5) @ dX2_s5
let dpre_b2_s5 = (dX2_s5 @ transpose(w2_2_v4)) * ge(pre_b2_s5, [[0]])
let Gc1_2_s5 = col_sum(dpre_b2_s5)
let Gw1_2_s5 = transpose(u2_b2_s5) @ dpre_b2_s5
let du2_b2_s5 = dpre_b2_s5 @ transpose(w1_2_v4)
let Gn2_2_s5 = col_sum(du2_b2_s5)
let Gg2_2_s5 = col_sum(du2_b2_s5 * ln_hat(x1_b2_s5))
let dx1_b2_s5 = dX2_s5 + ln_back(du2_b2_s5, x1_b2_s5, g2_2_v4)
let Gwo1_2_s5 = transpose(o1_b2_s5) @ dx1_b2_s5
let do1_b2_s5 = dx1_b2_s5 @ transpose(wo1_2_v4)
let dv1_b2_s5 = transpose(a1_b2_s5) @ do1_b2_s5
let da1_b2_s5 = do1_b2_s5 @ transpose(v1_b2_s5)
let ds1_b2_s5 = a1_b2_s5 * (da1_b2_s5 - row_sum(a1_b2_s5 * da1_b2_s5))
let dq1_b2_s5 = ds1_b2_s5 @ k1_b2_s5 * 0.5
let dk1_b2_s5 = transpose(ds1_b2_s5) @ q1_b2_s5 * 0.5
let Gwq1_2_s5 = transpose(u1_b2_s5) @ dq1_b2_s5
let Gwk1_2_s5 = transpose(u1_b2_s5) @ dk1_b2_s5
let Gwv1_2_s5 = transpose(u1_b2_s5) @ dv1_b2_s5
let Gwo2_2_s5 = transpose(o2_b2_s5) @ dx1_b2_s5
let do2_b2_s5 = dx1_b2_s5 @ transpose(wo2_2_v4)
let dv2_b2_s5 = transpose(a2_b2_s5) @ do2_b2_s5
let da2_b2_s5 = do2_b2_s5 @ transpose(v2_b2_s5)
let ds2_b2_s5 = a2_b2_s5 * (da2_b2_s5 - row_sum(a2_b2_s5 * da2_b2_s5))
let dq2_b2_s5 = ds2_b2_s5 @ k2_b2_s5 * 0.5
let dk2_b2_s5 = transpose(ds2_b2_s5) @ q2_b2_s5 * 0.5
let Gwq2_2_s5 = transpose(u1_b2_s5) @ dq2_b2_s5
let Gwk2_2_s5 = transpose(u1_b2_s5) @ dk2_b2_s5
let Gwv2_2_s5 = transpose(u1_b2_s5) @ dv2_b2_s5
let du1_b2_s5 = dq1_b2_s5 @ transpose(wq1_2_v4) + dk1_b2_s5 @ transpose(wk1_2_v4) + dv1_b2_s5 @ transpose(wv1_2_v4) + dq2_b2_s5 @ transpose(wq2_2_v4) + dk2_b2_s5 @ transpose(wk2_2_v4) + dv2_b2_s5 @ transpose(wv2_2_v4)
let Gn1_2_s5 = col_sum(du1_b2_s5)
let Gg1_2_s5 = col_sum(du1_b2_s5 * ln_hat(x2_b1_s5))
let dX1_s5 = dx1_b2_s5 + ln_back(du1_b2_s5, x2_b1_s5, g1_2_v4)
let Gc2_1_s5 = col_sum(dX1_s5)
let Gw2_1_s5 = transpose(r_b1_s5) @ dX1_s5
let dpre_b1_s5 = (dX1_s5 @ transpose(w2_1_v4)) * ge(pre_b1_s5, [[0]])
let Gc1_1_s5 = col_sum(dpre_b1_s5)
let Gw1_1_s5 = transpose(u2_b1_s5) @ dpre_b1_s5
let du2_b1_s5 = dpre_b1_s5 @ transpose(w1_1_v4)
let Gn2_1_s5 = col_sum(du2_b1_s5)
let Gg2_1_s5 = col_sum(du2_b1_s5 * ln_hat(x1_b1_s5))
let dx1_b1_s5 = dX1_s5 + ln_back(du2_b1_s5, x1_b1_s5, g2_1_v4)
let Gwo1_1_s5 = transpose(o1_b1_s5) @ dx1_b1_s5
let do1_b1_s5 = dx1_b1_s5 @ transpose(wo1_1_v4)
let dv1_b1_s5 = transpose(a1_b1_s5) @ do1_b1_s5
let da1_b1_s5 = do1_b1_s5 @ transpose(v1_b1_s5)
let ds1_b1_s5 = a1_b1_s5 * (da1_b1_s5 - row_sum(a1_b1_s5 * da1_b1_s5))
let dq1_b1_s5 = ds1_b1_s5 @ k1_b1_s5 * 0.5
let dk1_b1_s5 = transpose(ds1_b1_s5) @ q1_b1_s5 * 0.5
let Gwq1_1_s5 = transpose(u1_b1_s5) @ dq1_b1_s5
let Gwk1_1_s5 = transpose(u1_b1_s5) @ dk1_b1_s5
let Gwv1_1_s5 = transpose(u1_b1_s5) @ dv1_b1_s5
let Gwo2_1_s5 = transpose(o2_b1_s5) @ dx1_b1_s5
let do2_b1_s5 = dx1_b1_s5 @ transpose(wo2_1_v4)
let dv2_b1_s5 = transpose(a2_b1_s5) @ do2_b1_s5
let da2_b1_s5 = do2_b1_s5 @ transpose(v2_b1_s5)
let ds2_b1_s5 = a2_b1_s5 * (da2_b1_s5 - row_sum(a2_b1_s5 * da2_b1_s5))
let dq2_b1_s5 = ds2_b1_s5 @ k2_b1_s5 * 0.5
let dk2_b1_s5 = transpose(ds2_b1_s5) @ q2_b1_s5 * 0.5
let Gwq2_1_s5 = transpose(u1_b1_s5) @ dq2_b1_s5
let Gwk2_1_s5 = transpose(u1_b1_s5) @ dk2_b1_s5
let Gwv2_1_s5 = transpose(u1_b1_s5) @ dv2_b1_s5
let du1_b1_s5 = dq1_b1_s5 @ transpose(wq1_1_v4) + dk1_b1_s5 @ transpose(wk1_1_v4) + dv1_b1_s5 @ transpose(wv1_1_v4) + dq2_b1_s5 @ transpose(wq2_1_v4) + dk2_b1_s5 @ transpose(wk2_1_v4) + dv2_b1_s5 @ transpose(wv2_1_v4)
let Gn1_1_s5 = col_sum(du1_b1_s5)
let Gg1_1_s5 = col_sum(du1_b1_s5 * ln_hat(x0_s5))
let dX0_s5 = dx1_b1_s5 + ln_back(du1_b1_s5, x0_s5, g1_1_v4)
let Ge_s5 = transpose(x) @ dX0_s5
let e_v5 = e_v4 - Ge_s5 * 0.5
let g1_1_v5 = g1_1_v4 - Gg1_1_s5 * 0.5
let n1_1_v5 = n1_1_v4 - Gn1_1_s5 * 0.5
