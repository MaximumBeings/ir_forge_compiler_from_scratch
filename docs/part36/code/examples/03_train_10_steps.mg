let Gwk2_2_s1 = transpose(u1_b2_s1) @ dk2_b2_s1
let Gwv2_2_s1 = transpose(u1_b2_s1) @ dv2_b2_s1
let du1_b2_s1 = dq1_b2_s1 @ transpose(wq1_2_v0) + dk1_b2_s1 @ transpose(wk1_2_v0) + dv1_b2_s1 @ transpose(wv1_2_v0) + dq2_b2_s1 @ transpose(wq2_2_v0) + dk2_b2_s1 @ transpose(wk2_2_v0) + dv2_b2_s1 @ transpose(wv2_2_v0)
