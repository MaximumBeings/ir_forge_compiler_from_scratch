let w2_1_v5 = w2_1_v4 - Gw2_1_s5 * 0.5
let c2_1_v5 = c2_1_v4 - Gc2_1_s5 * 0.5
let g1_2_v5 = g1_2_v4 - Gg1_2_s5 * 0.5
let n1_2_v5 = n1_2_v4 - Gn1_2_s5 * 0.5
let wq1_2_v5 = wq1_2_v4 - Gwq1_2_s5 * 0.5
let wk1_2_v5 = wk1_2_v4 - Gwk1_2_s5 * 0.5
let wv1_2_v5 = wv1_2_v4 - Gwv1_2_s5 * 0.5
let wo1_2_v5 = wo1_2_v4 - Gwo1_2_s5 * 0.5
let wq2_2_v5 = wq2_2_v4 - Gwq2_2_s5 * 0.5
let wk2_2_v5 = wk2_2_v4 - Gwk2_2_s5 * 0.5
