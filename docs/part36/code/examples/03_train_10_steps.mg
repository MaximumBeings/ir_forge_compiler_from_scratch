let du1_b1_s6 = dq1_b1_s6 @ transpose(wq1_1_v5) + dk1_b1_s6 @ transpose(wk1_1_v5) + dv1_b1_s6 @ transpose(wv1_1_v5) + dq2_b1_s6 @ transpose(wq2_1_v5) + dk2_b1_s6 @ transpose(wk2_1_v5) + dv2_b1_s6 @ transpose(wv2_1_v5)
