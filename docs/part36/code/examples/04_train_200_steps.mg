# ---- step 44: forward pass, backward pass, update
let x0_s44 = x @ e_v43 + ps
let u1_b1_s44 = ln_out(x0_s44, g1_1_v43, n1_1_v43)
let q1_b1_s44 = u1_b1_s44 @ wq1_1_v43
