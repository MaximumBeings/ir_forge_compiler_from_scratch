let w1_2_v41 = w1_2_v40 - Gw1_2_s41 * 0.5
let c1_2_v41 = c1_2_v40 - Gc1_2_s41 * 0.5
let w2_2_v41 = w2_2_v40 - Gw2_2_s41 * 0.5
let c2_2_v41 = c2_2_v40 - Gc2_2_s41 * 0.5
