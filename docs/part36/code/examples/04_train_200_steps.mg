let q2_b1_s32 = u1_b1_s32 @ wq2_1_v31
let k2_b1_s32 = u1_b1_s32 @ wk2_1_v31
let v2_b1_s32 = u1_b1_s32 @ wv2_1_v31
let a2_b1_s32 = softmax_rows(q2_b1_s32 @ transpose(k2_b1_s32) * 0.5 + mk)
let o2_b1_s32 = a2_b1_s32 @ v2_b1_s32
let x1_b1_s32 = x0_s32 + o1_b1_s32 @ wo1_1_v31 + o2_b1_s32 @ wo2_1_v31
let u2_b1_s32 = ln_out(x1_b1_s32, g2_1_v31, n2_1_v31)
let pre_b1_s32 = u2_b1_s32 @ w1_1_v31 + c1_1_v31
let r_b1_s32 = relu(pre_b1_s32)
let x2_b1_s32 = x1_b1_s32 + (r_b1_s32 @ w2_1_v31 + c2_1_v31)
let u1_b2_s32 = ln_out(x2_b1_s32, g1_2_v31, n1_2_v31)
let q1_b2_s32 = u1_b2_s32 @ wq1_2_v31
let k1_b2_s32 = u1_b2_s32 @ wk1_2_v31
let v1_b2_s32 = u1_b2_s32 @ wv1_2_v31
let a1_b2_s32 = softmax_rows(q1_b2_s32 @ transpose(k1_b2_s32) * 0.5 + mk)
let o1_b2_s32 = a1_b2_s32 @ v1_b2_s32
let q2_b2_s32 = u1_b2_s32 @ wq2_2_v31
let k2_b2_s32 = u1_b2_s32 @ wk2_2_v31
let v2_b2_s32 = u1_b2_s32 @ wv2_2_v31
let a2_b2_s32 = softmax_rows(q2_b2_s32 @ transpose(k2_b2_s32) * 0.5 + mk)
let o2_b2_s32 = a2_b2_s32 @ v2_b2_s32
let x1_b2_s32 = x2_b1_s32 + o1_b2_s32 @ wo1_2_v31 + o2_b2_s32 @ wo2_2_v31
