let u2_b1_s89 = ln_out(x1_b1_s89, g2_1_v88, n2_1_v88)
let pre_b1_s89 = u2_b1_s89 @ w1_1_v88 + c1_1_v88
let r_b1_s89 = relu(pre_b1_s89)
let x2_b1_s89 = x1_b1_s89 + (r_b1_s89 @ w2_1_v88 + c2_1_v88)
let u1_b2_s89 = ln_out(x2_b1_s89, g1_2_v88, n1_2_v88)
let q1_b2_s89 = u1_b2_s89 @ wq1_2_v88
let k1_b2_s89 = u1_b2_s89 @ wk1_2_v88
let v1_b2_s89 = u1_b2_s89 @ wv1_2_v88
let a1_b2_s89 = softmax_rows(q1_b2_s89 @ transpose(k1_b2_s89) * 0.5 + mk)
let o1_b2_s89 = a1_b2_s89 @ v1_b2_s89
let q2_b2_s89 = u1_b2_s89 @ wq2_2_v88
let k2_b2_s89 = u1_b2_s89 @ wk2_2_v88
let v2_b2_s89 = u1_b2_s89 @ wv2_2_v88
let a2_b2_s89 = softmax_rows(q2_b2_s89 @ transpose(k2_b2_s89) * 0.5 + mk)
let o2_b2_s89 = a2_b2_s89 @ v2_b2_s89
let x1_b2_s89 = x2_b1_s89 + o1_b2_s89 @ wo1_2_v88 + o2_b2_s89 @ wo2_2_v88
let u2_b2_s89 = ln_out(x1_b2_s89, g2_2_v88, n2_2_v88)
let pre_b2_s89 = u2_b2_s89 @ w1_2_v88 + c1_2_v88
let r_b2_s89 = relu(pre_b2_s89)
let x2_b2_s89 = x1_b2_s89 + (r_b2_s89 @ w2_2_v88 + c2_2_v88)
let uf_s89 = ln_out(x2_b2_s89, gf_v88, nf_v88)
let lg_s89 = uf_s89 @ wu_v88
let dl_s89 = (exp(log_softmax(lg_s89)) * mr - y) * 0.015625
let Gwu_s89 = transpose(uf_s89) @ dl_s89
let duf_s89 = dl_s89 @ transpose(wu_v88)
let Gnf_s89 = col_sum(duf_s89)
let Ggf_s89 = col_sum(duf_s89 * ln_hat(x2_b2_s89))
let dX2_s89 = ln_back(duf_s89, x2_b2_s89, gf_v88)
let Gc2_2_s89 = col_sum(dX2_s89)
let Gw2_2_s89 = transpose(r_b2_s89) @ dX2_s89
let dpre_b2_s89 = (dX2_s89 @ transpose(w2_2_v88)) * ge(pre_b2_s89, [[0]])
let Gc1_2_s89 = col_sum(dpre_b2_s89)
let Gw1_2_s89 = transpose(u2_b2_s89) @ dpre_b2_s89
let du2_b2_s89 = dpre_b2_s89 @ transpose(w1_2_v88)
let Gn2_2_s89 = col_sum(du2_b2_s89)
let Gg2_2_s89 = col_sum(du2_b2_s89 * ln_hat(x1_b2_s89))
let dx1_b2_s89 = dX2_s89 + ln_back(du2_b2_s89, x1_b2_s89, g2_2_v88)
let Gwo1_2_s89 = transpose(o1_b2_s89) @ dx1_b2_s89
let do1_b2_s89 = dx1_b2_s89 @ transpose(wo1_2_v88)
let dv1_b2_s89 = transpose(a1_b2_s89) @ do1_b2_s89
let da1_b2_s89 = do1_b2_s89 @ transpose(v1_b2_s89)
let ds1_b2_s89 = a1_b2_s89 * (da1_b2_s89 - row_sum(a1_b2_s89 * da1_b2_s89))
let dq1_b2_s89 = ds1_b2_s89 @ k1_b2_s89 * 0.5
let dk1_b2_s89 = transpose(ds1_b2_s89) @ q1_b2_s89 * 0.5
let Gwq1_2_s89 = transpose(u1_b2_s89) @ dq1_b2_s89
let Gwk1_2_s89 = transpose(u1_b2_s89) @ dk1_b2_s89
let Gwv1_2_s89 = transpose(u1_b2_s89) @ dv1_b2_s89
let Gwo2_2_s89 = transpose(o2_b2_s89) @ dx1_b2_s89
let do2_b2_s89 = dx1_b2_s89 @ transpose(wo2_2_v88)
let dv2_b2_s89 = transpose(a2_b2_s89) @ do2_b2_s89
let da2_b2_s89 = do2_b2_s89 @ transpose(v2_b2_s89)
let ds2_b2_s89 = a2_b2_s89 * (da2_b2_s89 - row_sum(a2_b2_s89 * da2_b2_s89))
let dq2_b2_s89 = ds2_b2_s89 @ k2_b2_s89 * 0.5
let dk2_b2_s89 = transpose(ds2_b2_s89) @ q2_b2_s89 * 0.5
let Gwq2_2_s89 = transpose(u1_b2_s89) @ dq2_b2_s89
let Gwk2_2_s89 = transpose(u1_b2_s89) @ dk2_b2_s89
let Gwv2_2_s89 = transpose(u1_b2_s89) @ dv2_b2_s89
let du1_b2_s89 = dq1_b2_s89 @ transpose(wq1_2_v88) + dk1_b2_s89 @ transpose(wk1_2_v88) + dv1_b2_s89 @ transpose(wv1_2_v88) + dq2_b2_s89 @ transpose(wq2_2_v88) + dk2_b2_s89 @ transpose(wk2_2_v88) + dv2_b2_s89 @ transpose(wv2_2_v88)
let Gn1_2_s89 = col_sum(du1_b2_s89)
let Gg1_2_s89 = col_sum(du1_b2_s89 * ln_hat(x2_b1_s89))
let dX1_s89 = dx1_b2_s89 + ln_back(du1_b2_s89, x2_b1_s89, g1_2_v88)
let Gc2_1_s89 = col_sum(dX1_s89)
let Gw2_1_s89 = transpose(r_b1_s89) @ dX1_s89
let dpre_b1_s89 = (dX1_s89 @ transpose(w2_1_v88)) * ge(pre_b1_s89, [[0]])
let Gc1_1_s89 = col_sum(dpre_b1_s89)
let Gw1_1_s89 = transpose(u2_b1_s89) @ dpre_b1_s89
let du2_b1_s89 = dpre_b1_s89 @ transpose(w1_1_v88)
let Gn2_1_s89 = col_sum(du2_b1_s89)
let Gg2_1_s89 = col_sum(du2_b1_s89 * ln_hat(x1_b1_s89))
let dx1_b1_s89 = dX1_s89 + ln_back(du2_b1_s89, x1_b1_s89, g2_1_v88)
let Gwo1_1_s89 = transpose(o1_b1_s89) @ dx1_b1_s89
let do1_b1_s89 = dx1_b1_s89 @ transpose(wo1_1_v88)
let dv1_b1_s89 = transpose(a1_b1_s89) @ do1_b1_s89
let da1_b1_s89 = do1_b1_s89 @ transpose(v1_b1_s89)
let ds1_b1_s89 = a1_b1_s89 * (da1_b1_s89 - row_sum(a1_b1_s89 * da1_b1_s89))
let dq1_b1_s89 = ds1_b1_s89 @ k1_b1_s89 * 0.5
let dk1_b1_s89 = transpose(ds1_b1_s89) @ q1_b1_s89 * 0.5
let Gwq1_1_s89 = transpose(u1_b1_s89) @ dq1_b1_s89
let Gwk1_1_s89 = transpose(u1_b1_s89) @ dk1_b1_s89
let Gwv1_1_s89 = transpose(u1_b1_s89) @ dv1_b1_s89
let Gwo2_1_s89 = transpose(o2_b1_s89) @ dx1_b1_s89
let do2_b1_s89 = dx1_b1_s89 @ transpose(wo2_1_v88)
let dv2_b1_s89 = transpose(a2_b1_s89) @ do2_b1_s89
let da2_b1_s89 = do2_b1_s89 @ transpose(v2_b1_s89)
let ds2_b1_s89 = a2_b1_s89 * (da2_b1_s89 - row_sum(a2_b1_s89 * da2_b1_s89))
let dq2_b1_s89 = ds2_b1_s89 @ k2_b1_s89 * 0.5
let dk2_b1_s89 = transpose(ds2_b1_s89) @ q2_b1_s89 * 0.5
let Gwq2_1_s89 = transpose(u1_b1_s89) @ dq2_b1_s89
let Gwk2_1_s89 = transpose(u1_b1_s89) @ dk2_b1_s89
let Gwv2_1_s89 = transpose(u1_b1_s89) @ dv2_b1_s89
let du1_b1_s89 = dq1_b1_s89 @ transpose(wq1_1_v88) + dk1_b1_s89 @ transpose(wk1_1_v88) + dv1_b1_s89 @ transpose(wv1_1_v88) + dq2_b1_s89 @ transpose(wq2_1_v88) + dk2_b1_s89 @ transpose(wk2_1_v88) + dv2_b1_s89 @ transpose(wv2_1_v88)
let Gn1_1_s89 = col_sum(du1_b1_s89)
let Gg1_1_s89 = col_sum(du1_b1_s89 * ln_hat(x0_s89))
let dX0_s89 = dx1_b1_s89 + ln_back(du1_b1_s89, x0_s89, g1_1_v88)
let Ge_s89 = transpose(x) @ dX0_s89
let e_v89 = e_v88 - Ge_s89 * 0.5
let g1_1_v89 = g1_1_v88 - Gg1_1_s89 * 0.5
let n1_1_v89 = n1_1_v88 - Gn1_1_s89 * 0.5
let wq1_1_v89 = wq1_1_v88 - Gwq1_1_s89 * 0.5
let wk1_1_v89 = wk1_1_v88 - Gwk1_1_s89 * 0.5
let wv1_1_v89 = wv1_1_v88 - Gwv1_1_s89 * 0.5
let wo1_1_v89 = wo1_1_v88 - Gwo1_1_s89 * 0.5
let wq2_1_v89 = wq2_1_v88 - Gwq2_1_s89 * 0.5
let wk2_1_v89 = wk2_1_v88 - Gwk2_1_s89 * 0.5
let wv2_1_v89 = wv2_1_v88 - Gwv2_1_s89 * 0.5
let wo2_1_v89 = wo2_1_v88 - Gwo2_1_s89 * 0.5
let g2_1_v89 = g2_1_v88 - Gg2_1_s89 * 0.5
let n2_1_v89 = n2_1_v88 - Gn2_1_s89 * 0.5
let w1_1_v89 = w1_1_v88 - Gw1_1_s89 * 0.5
let c1_1_v89 = c1_1_v88 - Gc1_1_s89 * 0.5
let w2_1_v89 = w2_1_v88 - Gw2_1_s89 * 0.5
let c2_1_v89 = c2_1_v88 - Gc2_1_s89 * 0.5
let g1_2_v89 = g1_2_v88 - Gg1_2_s89 * 0.5
let n1_2_v89 = n1_2_v88 - Gn1_2_s89 * 0.5
let wq1_2_v89 = wq1_2_v88 - Gwq1_2_s89 * 0.5
let wk1_2_v89 = wk1_2_v88 - Gwk1_2_s89 * 0.5
let wv1_2_v89 = wv1_2_v88 - Gwv1_2_s89 * 0.5
let wo1_2_v89 = wo1_2_v88 - Gwo1_2_s89 * 0.5
let wq2_2_v89 = wq2_2_v88 - Gwq2_2_s89 * 0.5
let wk2_2_v89 = wk2_2_v88 - Gwk2_2_s89 * 0.5
let wv2_2_v89 = wv2_2_v88 - Gwv2_2_s89 * 0.5
let wo2_2_v89 = wo2_2_v88 - Gwo2_2_s89 * 0.5
let g2_2_v89 = g2_2_v88 - Gg2_2_s89 * 0.5
let n2_2_v89 = n2_2_v88 - Gn2_2_s89 * 0.5
let w1_2_v89 = w1_2_v88 - Gw1_2_s89 * 0.5
let c1_2_v89 = c1_2_v88 - Gc1_2_s89 * 0.5
let w2_2_v89 = w2_2_v88 - Gw2_2_s89 * 0.5
let c2_2_v89 = c2_2_v88 - Gc2_2_s89 * 0.5
let gf_v89 = gf_v88 - Ggf_s89 * 0.5
let nf_v89 = nf_v88 - Gnf_s89 * 0.5
let wu_v89 = wu_v88 - Gwu_s89 * 0.5
# ---- step 90: forward pass, backward pass, update
let x0_s90 = x @ e_v89 + ps
let u1_b1_s90 = ln_out(x0_s90, g1_1_v89, n1_1_v89)
let q1_b1_s90 = u1_b1_s90 @ wq1_1_v89
let k1_b1_s90 = u1_b1_s90 @ wk1_1_v89
let v1_b1_s90 = u1_b1_s90 @ wv1_1_v89
let a1_b1_s90 = softmax_rows(q1_b1_s90 @ transpose(k1_b1_s90) * 0.5 + mk)
let o1_b1_s90 = a1_b1_s90 @ v1_b1_s90
let q2_b1_s90 = u1_b1_s90 @ wq2_1_v89
let k2_b1_s90 = u1_b1_s90 @ wk2_1_v89
let v2_b1_s90 = u1_b1_s90 @ wv2_1_v89
let a2_b1_s90 = softmax_rows(q2_b1_s90 @ transpose(k2_b1_s90) * 0.5 + mk)
let o2_b1_s90 = a2_b1_s90 @ v2_b1_s90
let x1_b1_s90 = x0_s90 + o1_b1_s90 @ wo1_1_v89 + o2_b1_s90 @ wo2_1_v89
let u2_b1_s90 = ln_out(x1_b1_s90, g2_1_v89, n2_1_v89)
let pre_b1_s90 = u2_b1_s90 @ w1_1_v89 + c1_1_v89
let r_b1_s90 = relu(pre_b1_s90)
let x2_b1_s90 = x1_b1_s90 + (r_b1_s90 @ w2_1_v89 + c2_1_v89)
let u1_b2_s90 = ln_out(x2_b1_s90, g1_2_v89, n1_2_v89)
let q1_b2_s90 = u1_b2_s90 @ wq1_2_v89
let k1_b2_s90 = u1_b2_s90 @ wk1_2_v89
let v1_b2_s90 = u1_b2_s90 @ wv1_2_v89
let a1_b2_s90 = softmax_rows(q1_b2_s90 @ transpose(k1_b2_s90) * 0.5 + mk)
let o1_b2_s90 = a1_b2_s90 @ v1_b2_s90
let q2_b2_s90 = u1_b2_s90 @ wq2_2_v89
let k2_b2_s90 = u1_b2_s90 @ wk2_2_v89
let v2_b2_s90 = u1_b2_s90 @ wv2_2_v89
let a2_b2_s90 = softmax_rows(q2_b2_s90 @ transpose(k2_b2_s90) * 0.5 + mk)
let o2_b2_s90 = a2_b2_s90 @ v2_b2_s90
let x1_b2_s90 = x2_b1_s90 + o1_b2_s90 @ wo1_2_v89 + o2_b2_s90 @ wo2_2_v89
let u2_b2_s90 = ln_out(x1_b2_s90, g2_2_v89, n2_2_v89)
let pre_b2_s90 = u2_b2_s90 @ w1_2_v89 + c1_2_v89
let r_b2_s90 = relu(pre_b2_s90)
let x2_b2_s90 = x1_b2_s90 + (r_b2_s90 @ w2_2_v89 + c2_2_v89)
let uf_s90 = ln_out(x2_b2_s90, gf_v89, nf_v89)
let lg_s90 = uf_s90 @ wu_v89
let dl_s90 = (exp(log_softmax(lg_s90)) * mr - y) * 0.015625
let Gwu_s90 = transpose(uf_s90) @ dl_s90
let duf_s90 = dl_s90 @ transpose(wu_v89)
let Gnf_s90 = col_sum(duf_s90)
let Ggf_s90 = col_sum(duf_s90 * ln_hat(x2_b2_s90))
let dX2_s90 = ln_back(duf_s90, x2_b2_s90, gf_v89)
let Gc2_2_s90 = col_sum(dX2_s90)
let Gw2_2_s90 = transpose(r_b2_s90) @ dX2_s90
let dpre_b2_s90 = (dX2_s90 @ transpose(w2_2_v89)) * ge(pre_b2_s90, [[0]])
let Gc1_2_s90 = col_sum(dpre_b2_s90)
let Gw1_2_s90 = transpose(u2_b2_s90) @ dpre_b2_s90
let du2_b2_s90 = dpre_b2_s90 @ transpose(w1_2_v89)
let Gn2_2_s90 = col_sum(du2_b2_s90)
let Gg2_2_s90 = col_sum(du2_b2_s90 * ln_hat(x1_b2_s90))
let dx1_b2_s90 = dX2_s90 + ln_back(du2_b2_s90, x1_b2_s90, g2_2_v89)
let Gwo1_2_s90 = transpose(o1_b2_s90) @ dx1_b2_s90
let do1_b2_s90 = dx1_b2_s90 @ transpose(wo1_2_v89)
let dv1_b2_s90 = transpose(a1_b2_s90) @ do1_b2_s90
let da1_b2_s90 = do1_b2_s90 @ transpose(v1_b2_s90)
let ds1_b2_s90 = a1_b2_s90 * (da1_b2_s90 - row_sum(a1_b2_s90 * da1_b2_s90))
let dq1_b2_s90 = ds1_b2_s90 @ k1_b2_s90 * 0.5
let dk1_b2_s90 = transpose(ds1_b2_s90) @ q1_b2_s90 * 0.5
let Gwq1_2_s90 = transpose(u1_b2_s90) @ dq1_b2_s90
let Gwk1_2_s90 = transpose(u1_b2_s90) @ dk1_b2_s90
let Gwv1_2_s90 = transpose(u1_b2_s90) @ dv1_b2_s90
let Gwo2_2_s90 = transpose(o2_b2_s90) @ dx1_b2_s90
let do2_b2_s90 = dx1_b2_s90 @ transpose(wo2_2_v89)
let dv2_b2_s90 = transpose(a2_b2_s90) @ do2_b2_s90
let da2_b2_s90 = do2_b2_s90 @ transpose(v2_b2_s90)
let ds2_b2_s90 = a2_b2_s90 * (da2_b2_s90 - row_sum(a2_b2_s90 * da2_b2_s90))
