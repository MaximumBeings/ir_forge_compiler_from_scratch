let v1_b2_s49 = u1_b2_s49 @ wv1_2_v48
let a1_b2_s49 = softmax_rows(q1_b2_s49 @ transpose(k1_b2_s49) * 0.5 + mk)
let o1_b2_s49 = a1_b2_s49 @ v1_b2_s49
let q2_b2_s49 = u1_b2_s49 @ wq2_2_v48
let k2_b2_s49 = u1_b2_s49 @ wk2_2_v48
let v2_b2_s49 = u1_b2_s49 @ wv2_2_v48
let a2_b2_s49 = softmax_rows(q2_b2_s49 @ transpose(k2_b2_s49) * 0.5 + mk)
let o2_b2_s49 = a2_b2_s49 @ v2_b2_s49
let x1_b2_s49 = x2_b1_s49 + o1_b2_s49 @ wo1_2_v48 + o2_b2_s49 @ wo2_2_v48
let u2_b2_s49 = ln_out(x1_b2_s49, g2_2_v48, n2_2_v48)
let pre_b2_s49 = u2_b2_s49 @ w1_2_v48 + c1_2_v48
let r_b2_s49 = relu(pre_b2_s49)
let x2_b2_s49 = x1_b2_s49 + (r_b2_s49 @ w2_2_v48 + c2_2_v48)
