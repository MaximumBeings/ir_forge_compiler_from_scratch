let wo2_2_v52 = wo2_2_v51 - Gwo2_2_s52 * 0.5
let g2_2_v52 = g2_2_v51 - Gg2_2_s52 * 0.5
let n2_2_v52 = n2_2_v51 - Gn2_2_s52 * 0.5
