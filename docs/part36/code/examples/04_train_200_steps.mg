# ---- step 100: forward pass, backward pass, update
let x0_s100 = x @ e_v99 + ps
let u1_b1_s100 = ln_out(x0_s100, g1_1_v99, n1_1_v99)
let q1_b1_s100 = u1_b1_s100 @ wq1_1_v99
