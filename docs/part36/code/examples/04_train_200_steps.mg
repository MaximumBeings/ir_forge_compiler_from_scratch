let w1_2_v43 = w1_2_v42 - Gw1_2_s43 * 0.5
let c1_2_v43 = c1_2_v42 - Gc1_2_s43 * 0.5
let w2_2_v43 = w2_2_v42 - Gw2_2_s43 * 0.5
let c2_2_v43 = c2_2_v42 - Gc2_2_s43 * 0.5
