let o1_b1_s50 = a1_b1_s50 @ v1_b1_s50
let q2_b1_s50 = u1_b1_s50 @ wq2_1_v49
let k2_b1_s50 = u1_b1_s50 @ wk2_1_v49
let v2_b1_s50 = u1_b1_s50 @ wv2_1_v49
let a2_b1_s50 = softmax_rows(q2_b1_s50 @ transpose(k2_b1_s50) * 0.5 + mk)
let o2_b1_s50 = a2_b1_s50 @ v2_b1_s50
let x1_b1_s50 = x0_s50 + o1_b1_s50 @ wo1_1_v49 + o2_b1_s50 @ wo2_1_v49
let u2_b1_s50 = ln_out(x1_b1_s50, g2_1_v49, n2_1_v49)
let pre_b1_s50 = u2_b1_s50 @ w1_1_v49 + c1_1_v49
let r_b1_s50 = relu(pre_b1_s50)
let x2_b1_s50 = x1_b1_s50 + (r_b1_s50 @ w2_1_v49 + c2_1_v49)
let u1_b2_s50 = ln_out(x2_b1_s50, g1_2_v49, n1_2_v49)
let q1_b2_s50 = u1_b2_s50 @ wq1_2_v49
let k1_b2_s50 = u1_b2_s50 @ wk1_2_v49
let v1_b2_s50 = u1_b2_s50 @ wv1_2_v49
let a1_b2_s50 = softmax_rows(q1_b2_s50 @ transpose(k1_b2_s50) * 0.5 + mk)
let o1_b2_s50 = a1_b2_s50 @ v1_b2_s50
let q2_b2_s50 = u1_b2_s50 @ wq2_2_v49
let k2_b2_s50 = u1_b2_s50 @ wk2_2_v49
let v2_b2_s50 = u1_b2_s50 @ wv2_2_v49
let a2_b2_s50 = softmax_rows(q2_b2_s50 @ transpose(k2_b2_s50) * 0.5 + mk)
let o2_b2_s50 = a2_b2_s50 @ v2_b2_s50
let x1_b2_s50 = x2_b1_s50 + o1_b2_s50 @ wo1_2_v49 + o2_b2_s50 @ wo2_2_v49
let u2_b2_s50 = ln_out(x1_b2_s50, g2_2_v49, n2_2_v49)
let pre_b2_s50 = u2_b2_s50 @ w1_2_v49 + c1_2_v49
