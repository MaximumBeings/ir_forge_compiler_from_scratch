let v2_b2_s99 = u1_b2_s99 @ wv2_2_v98
let a2_b2_s99 = softmax_rows(q2_b2_s99 @ transpose(k2_b2_s99) * 0.5 + mk)
let o2_b2_s99 = a2_b2_s99 @ v2_b2_s99
