let pre_b2_s32 = u2_b2_s32 @ w1_2_v31 + c1_2_v31
let r_b2_s32 = relu(pre_b2_s32)
let x2_b2_s32 = x1_b2_s32 + (r_b2_s32 @ w2_2_v31 + c2_2_v31)
let uf_s32 = ln_out(x2_b2_s32, gf_v31, nf_v31)
let lg_s32 = uf_s32 @ wu_v31
let dl_s32 = (exp(log_softmax(lg_s32)) * mr - y) * 0.015625
let Gwu_s32 = transpose(uf_s32) @ dl_s32
