let o2_b1_s53 = a2_b1_s53 @ v2_b1_s53
let x1_b1_s53 = x0_s53 + o1_b1_s53 @ wo1_1_v52 + o2_b1_s53 @ wo2_1_v52
let u2_b1_s53 = ln_out(x1_b1_s53, g2_1_v52, n2_1_v52)
let pre_b1_s53 = u2_b1_s53 @ w1_1_v52 + c1_1_v52
let r_b1_s53 = relu(pre_b1_s53)
let x2_b1_s53 = x1_b1_s53 + (r_b1_s53 @ w2_1_v52 + c2_1_v52)
let u1_b2_s53 = ln_out(x2_b1_s53, g1_2_v52, n1_2_v52)
let q1_b2_s53 = u1_b2_s53 @ wq1_2_v52
