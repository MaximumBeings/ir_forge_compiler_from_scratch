let n1_2_v31 = n1_2_v30 - Gn1_2_s31 * 0.5
let wq1_2_v31 = wq1_2_v30 - Gwq1_2_s31 * 0.5
let wk1_2_v31 = wk1_2_v30 - Gwk1_2_s31 * 0.5
let wv1_2_v31 = wv1_2_v30 - Gwv1_2_s31 * 0.5
let wo1_2_v31 = wo1_2_v30 - Gwo1_2_s31 * 0.5
let wq2_2_v31 = wq2_2_v30 - Gwq2_2_s31 * 0.5
let wk2_2_v31 = wk2_2_v30 - Gwk2_2_s31 * 0.5
let wv2_2_v31 = wv2_2_v30 - Gwv2_2_s31 * 0.5
let wo2_2_v31 = wo2_2_v30 - Gwo2_2_s31 * 0.5
let g2_2_v31 = g2_2_v30 - Gg2_2_s31 * 0.5
let n2_2_v31 = n2_2_v30 - Gn2_2_s31 * 0.5
let w1_2_v31 = w1_2_v30 - Gw1_2_s31 * 0.5
let c1_2_v31 = c1_2_v30 - Gc1_2_s31 * 0.5
let w2_2_v31 = w2_2_v30 - Gw2_2_s31 * 0.5
let c2_2_v31 = c2_2_v30 - Gc2_2_s31 * 0.5
let gf_v31 = gf_v30 - Ggf_s31 * 0.5
let nf_v31 = nf_v30 - Gnf_s31 * 0.5
let wu_v31 = wu_v30 - Gwu_s31 * 0.5
# ---- step 32: forward pass, backward pass, update
let x0_s32 = x @ e_v31 + ps
let u1_b1_s32 = ln_out(x0_s32, g1_1_v31, n1_1_v31)
let q1_b1_s32 = u1_b1_s32 @ wq1_1_v31
