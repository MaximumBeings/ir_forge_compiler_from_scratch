let wu_v52 = wu_v51 - Gwu_s52 * 0.5
# ---- step 53: forward pass, backward pass, update
let x0_s53 = x @ e_v52 + ps
let u1_b1_s53 = ln_out(x0_s53, g1_1_v52, n1_1_v52)
let q1_b1_s53 = u1_b1_s53 @ wq1_1_v52
