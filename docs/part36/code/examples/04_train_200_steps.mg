let x2_b2_s50 = x1_b2_s50 + (r_b2_s50 @ w2_2_v49 + c2_2_v49)
let uf_s50 = ln_out(x2_b2_s50, gf_v49, nf_v49)
let lg_s50 = uf_s50 @ wu_v49
let dl_s50 = (exp(log_softmax(lg_s50)) * mr - y) * 0.015625
let Gwu_s50 = transpose(uf_s50) @ dl_s50
let duf_s50 = dl_s50 @ transpose(wu_v49)
let Gnf_s50 = col_sum(duf_s50)
let Ggf_s50 = col_sum(duf_s50 * ln_hat(x2_b2_s50))
let dX2_s50 = ln_back(duf_s50, x2_b2_s50, gf_v49)
let Gc2_2_s50 = col_sum(dX2_s50)
let Gw2_2_s50 = transpose(r_b2_s50) @ dX2_s50
let dpre_b2_s50 = (dX2_s50 @ transpose(w2_2_v49)) * ge(pre_b2_s50, [[0]])
let Gc1_2_s50 = col_sum(dpre_b2_s50)
let Gw1_2_s50 = transpose(u2_b2_s50) @ dpre_b2_s50
let du2_b2_s50 = dpre_b2_s50 @ transpose(w1_2_v49)
let Gn2_2_s50 = col_sum(du2_b2_s50)
let Gg2_2_s50 = col_sum(du2_b2_s50 * ln_hat(x1_b2_s50))
let dx1_b2_s50 = dX2_s50 + ln_back(du2_b2_s50, x1_b2_s50, g2_2_v49)
let Gwo1_2_s50 = transpose(o1_b2_s50) @ dx1_b2_s50
let do1_b2_s50 = dx1_b2_s50 @ transpose(wo1_2_v49)
let dv1_b2_s50 = transpose(a1_b2_s50) @ do1_b2_s50
let da1_b2_s50 = do1_b2_s50 @ transpose(v1_b2_s50)
let ds1_b2_s50 = a1_b2_s50 * (da1_b2_s50 - row_sum(a1_b2_s50 * da1_b2_s50))
let dq1_b2_s50 = ds1_b2_s50 @ k1_b2_s50 * 0.5
let dk1_b2_s50 = transpose(ds1_b2_s50) @ q1_b2_s50 * 0.5
let Gwq1_2_s50 = transpose(u1_b2_s50) @ dq1_b2_s50
let Gwk1_2_s50 = transpose(u1_b2_s50) @ dk1_b2_s50
let Gwv1_2_s50 = transpose(u1_b2_s50) @ dv1_b2_s50
let Gwo2_2_s50 = transpose(o2_b2_s50) @ dx1_b2_s50
let do2_b2_s50 = dx1_b2_s50 @ transpose(wo2_2_v49)
let dv2_b2_s50 = transpose(a2_b2_s50) @ do2_b2_s50
let da2_b2_s50 = do2_b2_s50 @ transpose(v2_b2_s50)
let ds2_b2_s50 = a2_b2_s50 * (da2_b2_s50 - row_sum(a2_b2_s50 * da2_b2_s50))
