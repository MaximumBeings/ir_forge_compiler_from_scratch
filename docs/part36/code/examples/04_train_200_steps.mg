# ---- step 49: forward pass, backward pass, update
let x0_s49 = x @ e_v48 + ps
let u1_b1_s49 = ln_out(x0_s49, g1_1_v48, n1_1_v48)
let q1_b1_s49 = u1_b1_s49 @ wq1_1_v48
