let du1_b1_s11 = dq1_b1_s11 @ transpose(wq1_1_v10) + dk1_b1_s11 @ transpose(wk1_1_v10) + dv1_b1_s11 @ transpose(wv1_1_v10) + dq2_b1_s11 @ transpose(wq2_1_v10) + dk2_b1_s11 @ transpose(wk2_1_v10) + dv2_b1_s11 @ transpose(wv2_1_v10)
