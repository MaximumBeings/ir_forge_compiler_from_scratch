let do2_b2_s99 = dx1_b2_s99 @ transpose(wo2_2_v98)
let dv2_b2_s99 = transpose(a2_b2_s99) @ do2_b2_s99
let da2_b2_s99 = do2_b2_s99 @ transpose(v2_b2_s99)
let ds2_b2_s99 = a2_b2_s99 * (da2_b2_s99 - row_sum(a2_b2_s99 * da2_b2_s99))
