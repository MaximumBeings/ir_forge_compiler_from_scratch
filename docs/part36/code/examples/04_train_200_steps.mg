let do1_b2_s49 = dx1_b2_s49 @ transpose(wo1_2_v48)
let dv1_b2_s49 = transpose(a1_b2_s49) @ do1_b2_s49
let da1_b2_s49 = do1_b2_s49 @ transpose(v1_b2_s49)
let ds1_b2_s49 = a1_b2_s49 * (da1_b2_s49 - row_sum(a1_b2_s49 * da1_b2_s49))
let dq1_b2_s49 = ds1_b2_s49 @ k1_b2_s49 * 0.5
let dk1_b2_s49 = transpose(ds1_b2_s49) @ q1_b2_s49 * 0.5
let Gwq1_2_s49 = transpose(u1_b2_s49) @ dq1_b2_s49
let Gwk1_2_s49 = transpose(u1_b2_s49) @ dk1_b2_s49
let Gwv1_2_s49 = transpose(u1_b2_s49) @ dv1_b2_s49
let Gwo2_2_s49 = transpose(o2_b2_s49) @ dx1_b2_s49
let do2_b2_s49 = dx1_b2_s49 @ transpose(wo2_2_v48)
let dv2_b2_s49 = transpose(a2_b2_s49) @ do2_b2_s49
let da2_b2_s49 = do2_b2_s49 @ transpose(v2_b2_s49)
let ds2_b2_s49 = a2_b2_s49 * (da2_b2_s49 - row_sum(a2_b2_s49 * da2_b2_s49))
