let q2_b2_s53 = u1_b2_s53 @ wq2_2_v52
let k2_b2_s53 = u1_b2_s53 @ wk2_2_v52
let v2_b2_s53 = u1_b2_s53 @ wv2_2_v52
let a2_b2_s53 = softmax_rows(q2_b2_s53 @ transpose(k2_b2_s53) * 0.5 + mk)
let o2_b2_s53 = a2_b2_s53 @ v2_b2_s53
