let dk2_b2_s49 = transpose(ds2_b2_s49) @ q2_b2_s49 * 0.5
let Gwq2_2_s49 = transpose(u1_b2_s49) @ dq2_b2_s49
let Gwk2_2_s49 = transpose(u1_b2_s49) @ dk2_b2_s49
let Gwv2_2_s49 = transpose(u1_b2_s49) @ dv2_b2_s49
let du1_b2_s49 = dq1_b2_s49 @ transpose(wq1_2_v48) + dk1_b2_s49 @ transpose(wk1_2_v48) + dv1_b2_s49 @ transpose(wv1_2_v48) + dq2_b2_s49 @ transpose(wq2_2_v48) + dk2_b2_s49 @ transpose(wk2_2_v48) + dv2_b2_s49 @ transpose(wv2_2_v48)
let Gn1_2_s49 = col_sum(du1_b2_s49)
let Gg1_2_s49 = col_sum(du1_b2_s49 * ln_hat(x2_b1_s49))
let dX1_s49 = dx1_b2_s49 + ln_back(du1_b2_s49, x2_b1_s49, g1_2_v48)
let Gc2_1_s49 = col_sum(dX1_s49)
let Gw2_1_s49 = transpose(r_b1_s49) @ dX1_s49
let dpre_b1_s49 = (dX1_s49 @ transpose(w2_1_v48)) * ge(pre_b1_s49, [[0]])
let Gc1_1_s49 = col_sum(dpre_b1_s49)
let Gw1_1_s49 = transpose(u2_b1_s49) @ dpre_b1_s49
let du2_b1_s49 = dpre_b1_s49 @ transpose(w1_1_v48)
let Gn2_1_s49 = col_sum(du2_b1_s49)
let Gg2_1_s49 = col_sum(du2_b1_s49 * ln_hat(x1_b1_s49))
let dx1_b1_s49 = dX1_s49 + ln_back(du2_b1_s49, x1_b1_s49, g2_1_v48)
let Gwo1_1_s49 = transpose(o1_b1_s49) @ dx1_b1_s49
let do1_b1_s49 = dx1_b1_s49 @ transpose(wo1_1_v48)
let dv1_b1_s49 = transpose(a1_b1_s49) @ do1_b1_s49
let da1_b1_s49 = do1_b1_s49 @ transpose(v1_b1_s49)
let ds1_b1_s49 = a1_b1_s49 * (da1_b1_s49 - row_sum(a1_b1_s49 * da1_b1_s49))
let dq1_b1_s49 = ds1_b1_s49 @ k1_b1_s49 * 0.5
let dk1_b1_s49 = transpose(ds1_b1_s49) @ q1_b1_s49 * 0.5
let Gwq1_1_s49 = transpose(u1_b1_s49) @ dq1_b1_s49
let Gwk1_1_s49 = transpose(u1_b1_s49) @ dk1_b1_s49
let Gwv1_1_s49 = transpose(u1_b1_s49) @ dv1_b1_s49
let Gwo2_1_s49 = transpose(o2_b1_s49) @ dx1_b1_s49
let do2_b1_s49 = dx1_b1_s49 @ transpose(wo2_1_v48)
let dv2_b1_s49 = transpose(a2_b1_s49) @ do2_b1_s49
