let Gwk2_2_s90 = transpose(u1_b2_s90) @ dk2_b2_s90
let Gwv2_2_s90 = transpose(u1_b2_s90) @ dv2_b2_s90
let du1_b2_s90 = dq1_b2_s90 @ transpose(wq1_2_v89) + dk1_b2_s90 @ transpose(wk1_2_v89) + dv1_b2_s90 @ transpose(wv1_2_v89) + dq2_b2_s90 @ transpose(wq2_2_v89) + dk2_b2_s90 @ transpose(wk2_2_v89) + dv2_b2_s90 @ transpose(wv2_2_v89)
let Gn1_2_s90 = col_sum(du1_b2_s90)
let Gg1_2_s90 = col_sum(du1_b2_s90 * ln_hat(x2_b1_s90))
let dX1_s90 = dx1_b2_s90 + ln_back(du1_b2_s90, x2_b1_s90, g1_2_v89)
let Gc2_1_s90 = col_sum(dX1_s90)
let Gw2_1_s90 = transpose(r_b1_s90) @ dX1_s90
let dpre_b1_s90 = (dX1_s90 @ transpose(w2_1_v89)) * ge(pre_b1_s90, [[0]])
let Gc1_1_s90 = col_sum(dpre_b1_s90)
let Gw1_1_s90 = transpose(u2_b1_s90) @ dpre_b1_s90
let du2_b1_s90 = dpre_b1_s90 @ transpose(w1_1_v89)
let Gn2_1_s90 = col_sum(du2_b1_s90)
let Gg2_1_s90 = col_sum(du2_b1_s90 * ln_hat(x1_b1_s90))
let dx1_b1_s90 = dX1_s90 + ln_back(du2_b1_s90, x1_b1_s90, g2_1_v89)
let Gwo1_1_s90 = transpose(o1_b1_s90) @ dx1_b1_s90
let do1_b1_s90 = dx1_b1_s90 @ transpose(wo1_1_v89)
let dv1_b1_s90 = transpose(a1_b1_s90) @ do1_b1_s90
let da1_b1_s90 = do1_b1_s90 @ transpose(v1_b1_s90)
let ds1_b1_s90 = a1_b1_s90 * (da1_b1_s90 - row_sum(a1_b1_s90 * da1_b1_s90))
let dq1_b1_s90 = ds1_b1_s90 @ k1_b1_s90 * 0.5
let dk1_b1_s90 = transpose(ds1_b1_s90) @ q1_b1_s90 * 0.5
let Gwq1_1_s90 = transpose(u1_b1_s90) @ dq1_b1_s90
let Gwk1_1_s90 = transpose(u1_b1_s90) @ dk1_b1_s90
let Gwv1_1_s90 = transpose(u1_b1_s90) @ dv1_b1_s90
let Gwo2_1_s90 = transpose(o2_b1_s90) @ dx1_b1_s90
let do2_b1_s90 = dx1_b1_s90 @ transpose(wo2_1_v89)
let dv2_b1_s90 = transpose(a2_b1_s90) @ do2_b1_s90
let da2_b1_s90 = do2_b1_s90 @ transpose(v2_b1_s90)
let ds2_b1_s90 = a2_b1_s90 * (da2_b1_s90 - row_sum(a2_b1_s90 * da2_b1_s90))
