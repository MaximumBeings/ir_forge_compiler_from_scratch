# ---- step 41: forward pass, backward pass, update
let x0_s41 = x @ e_v40 + ps
let u1_b1_s41 = ln_out(x0_s41, g1_1_v40, n1_1_v40)
let q1_b1_s41 = u1_b1_s41 @ wq1_1_v40
