let Gwo1_1_s52 = transpose(o1_b1_s52) @ dx1_b1_s52
let do1_b1_s52 = dx1_b1_s52 @ transpose(wo1_1_v51)
let dv1_b1_s52 = transpose(a1_b1_s52) @ do1_b1_s52
let da1_b1_s52 = do1_b1_s52 @ transpose(v1_b1_s52)
let ds1_b1_s52 = a1_b1_s52 * (da1_b1_s52 - row_sum(a1_b1_s52 * da1_b1_s52))
let dq1_b1_s52 = ds1_b1_s52 @ k1_b1_s52 * 0.5
let dk1_b1_s52 = transpose(ds1_b1_s52) @ q1_b1_s52 * 0.5
let Gwq1_1_s52 = transpose(u1_b1_s52) @ dq1_b1_s52
let Gwk1_1_s52 = transpose(u1_b1_s52) @ dk1_b1_s52
let Gwv1_1_s52 = transpose(u1_b1_s52) @ dv1_b1_s52
let Gwo2_1_s52 = transpose(o2_b1_s52) @ dx1_b1_s52
let do2_b1_s52 = dx1_b1_s52 @ transpose(wo2_1_v51)
let dv2_b1_s52 = transpose(a2_b1_s52) @ do2_b1_s52
let da2_b1_s52 = do2_b1_s52 @ transpose(v2_b1_s52)
let ds2_b1_s52 = a2_b1_s52 * (da2_b1_s52 - row_sum(a2_b1_s52 * da2_b1_s52))
