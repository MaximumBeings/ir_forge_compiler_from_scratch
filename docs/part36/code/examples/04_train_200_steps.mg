let dX1_s200 = dx1_b2_s200 + ln_back(du1_b2_s200, x2_b1_s200, g1_2_v199)
let Gc2_1_s200 = col_sum(dX1_s200)
let Gw2_1_s200 = transpose(r_b1_s200) @ dX1_s200
let dpre_b1_s200 = (dX1_s200 @ transpose(w2_1_v199)) * ge(pre_b1_s200, [[0]])
let Gc1_1_s200 = col_sum(dpre_b1_s200)
let Gw1_1_s200 = transpose(u2_b1_s200) @ dpre_b1_s200
let du2_b1_s200 = dpre_b1_s200 @ transpose(w1_1_v199)
let Gn2_1_s200 = col_sum(du2_b1_s200)
