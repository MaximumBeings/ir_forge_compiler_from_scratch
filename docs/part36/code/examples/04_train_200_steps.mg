let do2_b2_s44 = dx1_b2_s44 @ transpose(wo2_2_v43)
let dv2_b2_s44 = transpose(a2_b2_s44) @ do2_b2_s44
let da2_b2_s44 = do2_b2_s44 @ transpose(v2_b2_s44)
let ds2_b2_s44 = a2_b2_s44 * (da2_b2_s44 - row_sum(a2_b2_s44 * da2_b2_s44))
