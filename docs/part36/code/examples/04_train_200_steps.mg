let du1_b1_s99 = dq1_b1_s99 @ transpose(wq1_1_v98) + dk1_b1_s99 @ transpose(wk1_1_v98) + dv1_b1_s99 @ transpose(wv1_1_v98) + dq2_b1_s99 @ transpose(wq2_1_v98) + dk2_b1_s99 @ transpose(wk2_1_v98) + dv2_b1_s99 @ transpose(wv2_1_v98)
