let x2_b2_s100 = x1_b2_s100 + (r_b2_s100 @ w2_2_v99 + c2_2_v99)
let uf_s100 = ln_out(x2_b2_s100, gf_v99, nf_v99)
let lg_s100 = uf_s100 @ wu_v99
let dl_s100 = (exp(log_softmax(lg_s100)) * mr - y) * 0.015625
let Gwu_s100 = transpose(uf_s100) @ dl_s100
let duf_s100 = dl_s100 @ transpose(wu_v99)
let Gnf_s100 = col_sum(duf_s100)
let Ggf_s100 = col_sum(duf_s100 * ln_hat(x2_b2_s100))
let dX2_s100 = ln_back(duf_s100, x2_b2_s100, gf_v99)
let Gc2_2_s100 = col_sum(dX2_s100)
let Gw2_2_s100 = transpose(r_b2_s100) @ dX2_s100
let dpre_b2_s100 = (dX2_s100 @ transpose(w2_2_v99)) * ge(pre_b2_s100, [[0]])
let Gc1_2_s100 = col_sum(dpre_b2_s100)
let Gw1_2_s100 = transpose(u2_b2_s100) @ dpre_b2_s100
let du2_b2_s100 = dpre_b2_s100 @ transpose(w1_2_v99)
let Gn2_2_s100 = col_sum(du2_b2_s100)
let Gg2_2_s100 = col_sum(du2_b2_s100 * ln_hat(x1_b2_s100))
let dx1_b2_s100 = dX2_s100 + ln_back(du2_b2_s100, x1_b2_s100, g2_2_v99)
let Gwo1_2_s100 = transpose(o1_b2_s100) @ dx1_b2_s100
