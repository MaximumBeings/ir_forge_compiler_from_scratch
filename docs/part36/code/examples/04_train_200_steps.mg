let u2_b1_s100 = ln_out(x1_b1_s100, g2_1_v99, n2_1_v99)
let pre_b1_s100 = u2_b1_s100 @ w1_1_v99 + c1_1_v99
let r_b1_s100 = relu(pre_b1_s100)
