let v2_b2_s41 = u1_b2_s41 @ wv2_2_v40
let a2_b2_s41 = softmax_rows(q2_b2_s41 @ transpose(k2_b2_s41) * 0.5 + mk)
let o2_b2_s41 = a2_b2_s41 @ v2_b2_s41
