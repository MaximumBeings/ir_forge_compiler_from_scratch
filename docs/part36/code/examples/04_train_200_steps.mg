let v2_b2_s44 = u1_b2_s44 @ wv2_2_v43
let a2_b2_s44 = softmax_rows(q2_b2_s44 @ transpose(k2_b2_s44) * 0.5 + mk)
let o2_b2_s44 = a2_b2_s44 @ v2_b2_s44
