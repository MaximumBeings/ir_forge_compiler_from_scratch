let wo2_2_v49 = wo2_2_v48 - Gwo2_2_s49 * 0.5
let g2_2_v49 = g2_2_v48 - Gg2_2_s49 * 0.5
let n2_2_v49 = n2_2_v48 - Gn2_2_s49 * 0.5
let w1_2_v49 = w1_2_v48 - Gw1_2_s49 * 0.5
let c1_2_v49 = c1_2_v48 - Gc1_2_s49 * 0.5
let w2_2_v49 = w2_2_v48 - Gw2_2_s49 * 0.5
let c2_2_v49 = c2_2_v48 - Gc2_2_s49 * 0.5
let gf_v49 = gf_v48 - Ggf_s49 * 0.5
