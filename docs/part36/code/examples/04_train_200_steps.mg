let dpre_b2_s52 = (dX2_s52 @ transpose(w2_2_v51)) * ge(pre_b2_s52, [[0]])
let Gc1_2_s52 = col_sum(dpre_b2_s52)
let Gw1_2_s52 = transpose(u2_b2_s52) @ dpre_b2_s52
let du2_b2_s52 = dpre_b2_s52 @ transpose(w1_2_v51)
let Gn2_2_s52 = col_sum(du2_b2_s52)
let Gg2_2_s52 = col_sum(du2_b2_s52 * ln_hat(x1_b2_s52))
let dx1_b2_s52 = dX2_s52 + ln_back(du2_b2_s52, x1_b2_s52, g2_2_v51)
