let du2_b2_s31 = dpre_b2_s31 @ transpose(w1_2_v30)
let Gn2_2_s31 = col_sum(du2_b2_s31)
let Gg2_2_s31 = col_sum(du2_b2_s31 * ln_hat(x1_b2_s31))
let dx1_b2_s31 = dX2_s31 + ln_back(du2_b2_s31, x1_b2_s31, g2_2_v30)
let Gwo1_2_s31 = transpose(o1_b2_s31) @ dx1_b2_s31
let do1_b2_s31 = dx1_b2_s31 @ transpose(wo1_2_v30)
let dv1_b2_s31 = transpose(a1_b2_s31) @ do1_b2_s31
let da1_b2_s31 = do1_b2_s31 @ transpose(v1_b2_s31)
let ds1_b2_s31 = a1_b2_s31 * (da1_b2_s31 - row_sum(a1_b2_s31 * da1_b2_s31))
let dq1_b2_s31 = ds1_b2_s31 @ k1_b2_s31 * 0.5
let dk1_b2_s31 = transpose(ds1_b2_s31) @ q1_b2_s31 * 0.5
let Gwq1_2_s31 = transpose(u1_b2_s31) @ dq1_b2_s31
let Gwk1_2_s31 = transpose(u1_b2_s31) @ dk1_b2_s31
let Gwv1_2_s31 = transpose(u1_b2_s31) @ dv1_b2_s31
let Gwo2_2_s31 = transpose(o2_b2_s31) @ dx1_b2_s31
let do2_b2_s31 = dx1_b2_s31 @ transpose(wo2_2_v30)
let dv2_b2_s31 = transpose(a2_b2_s31) @ do2_b2_s31
let da2_b2_s31 = do2_b2_s31 @ transpose(v2_b2_s31)
let ds2_b2_s31 = a2_b2_s31 * (da2_b2_s31 - row_sum(a2_b2_s31 * da2_b2_s31))
let dq2_b2_s31 = ds2_b2_s31 @ k2_b2_s31 * 0.5
let dk2_b2_s31 = transpose(ds2_b2_s31) @ q2_b2_s31 * 0.5
let Gwq2_2_s31 = transpose(u1_b2_s31) @ dq2_b2_s31
let Gwk2_2_s31 = transpose(u1_b2_s31) @ dk2_b2_s31
let Gwv2_2_s31 = transpose(u1_b2_s31) @ dv2_b2_s31
let du1_b2_s31 = dq1_b2_s31 @ transpose(wq1_2_v30) + dk1_b2_s31 @ transpose(wk1_2_v30) + dv1_b2_s31 @ transpose(wv1_2_v30) + dq2_b2_s31 @ transpose(wq2_2_v30) + dk2_b2_s31 @ transpose(wk2_2_v30) + dv2_b2_s31 @ transpose(wv2_2_v30)
let Gn1_2_s31 = col_sum(du1_b2_s31)
let Gg1_2_s31 = col_sum(du1_b2_s31 * ln_hat(x2_b1_s31))
let dX1_s31 = dx1_b2_s31 + ln_back(du1_b2_s31, x2_b1_s31, g1_2_v30)
let Gc2_1_s31 = col_sum(dX1_s31)
let Gw2_1_s31 = transpose(r_b1_s31) @ dX1_s31
let dpre_b1_s31 = (dX1_s31 @ transpose(w2_1_v30)) * ge(pre_b1_s31, [[0]])
let Gc1_1_s31 = col_sum(dpre_b1_s31)
let Gw1_1_s31 = transpose(u2_b1_s31) @ dpre_b1_s31
let du2_b1_s31 = dpre_b1_s31 @ transpose(w1_1_v30)
let Gn2_1_s31 = col_sum(du2_b1_s31)
let Gg2_1_s31 = col_sum(du2_b1_s31 * ln_hat(x1_b1_s31))
let dx1_b1_s31 = dX1_s31 + ln_back(du2_b1_s31, x1_b1_s31, g2_1_v30)
let Gwo1_1_s31 = transpose(o1_b1_s31) @ dx1_b1_s31
let do1_b1_s31 = dx1_b1_s31 @ transpose(wo1_1_v30)
let dv1_b1_s31 = transpose(a1_b1_s31) @ do1_b1_s31
let da1_b1_s31 = do1_b1_s31 @ transpose(v1_b1_s31)
let ds1_b1_s31 = a1_b1_s31 * (da1_b1_s31 - row_sum(a1_b1_s31 * da1_b1_s31))
let dq1_b1_s31 = ds1_b1_s31 @ k1_b1_s31 * 0.5
let dk1_b1_s31 = transpose(ds1_b1_s31) @ q1_b1_s31 * 0.5
let Gwq1_1_s31 = transpose(u1_b1_s31) @ dq1_b1_s31
let Gwk1_1_s31 = transpose(u1_b1_s31) @ dk1_b1_s31
let Gwv1_1_s31 = transpose(u1_b1_s31) @ dv1_b1_s31
let Gwo2_1_s31 = transpose(o2_b1_s31) @ dx1_b1_s31
let do2_b1_s31 = dx1_b1_s31 @ transpose(wo2_1_v30)
let dv2_b1_s31 = transpose(a2_b1_s31) @ do2_b1_s31
let da2_b1_s31 = do2_b1_s31 @ transpose(v2_b1_s31)
let ds2_b1_s31 = a2_b1_s31 * (da2_b1_s31 - row_sum(a2_b1_s31 * da2_b1_s31))
let dq2_b1_s31 = ds2_b1_s31 @ k2_b1_s31 * 0.5
let dk2_b1_s31 = transpose(ds2_b1_s31) @ q2_b1_s31 * 0.5
let Gwq2_1_s31 = transpose(u1_b1_s31) @ dq2_b1_s31
let Gwk2_1_s31 = transpose(u1_b1_s31) @ dk2_b1_s31
let Gwv2_1_s31 = transpose(u1_b1_s31) @ dv2_b1_s31
let du1_b1_s31 = dq1_b1_s31 @ transpose(wq1_1_v30) + dk1_b1_s31 @ transpose(wk1_1_v30) + dv1_b1_s31 @ transpose(wv1_1_v30) + dq2_b1_s31 @ transpose(wq2_1_v30) + dk2_b1_s31 @ transpose(wk2_1_v30) + dv2_b1_s31 @ transpose(wv2_1_v30)
let Gn1_1_s31 = col_sum(du1_b1_s31)
let Gg1_1_s31 = col_sum(du1_b1_s31 * ln_hat(x0_s31))
let dX0_s31 = dx1_b1_s31 + ln_back(du1_b1_s31, x0_s31, g1_1_v30)
let Ge_s31 = transpose(x) @ dX0_s31
let e_v31 = e_v30 - Ge_s31 * 0.5
let g1_1_v31 = g1_1_v30 - Gg1_1_s31 * 0.5
let n1_1_v31 = n1_1_v30 - Gn1_1_s31 * 0.5
