let du2_b2_s49 = dpre_b2_s49 @ transpose(w1_2_v48)
let Gn2_2_s49 = col_sum(du2_b2_s49)
let Gg2_2_s49 = col_sum(du2_b2_s49 * ln_hat(x1_b2_s49))
let dx1_b2_s49 = dX2_s49 + ln_back(du2_b2_s49, x1_b2_s49, g2_2_v48)
