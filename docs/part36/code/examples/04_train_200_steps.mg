let do2_b1_s50 = dx1_b1_s50 @ transpose(wo2_1_v49)
let dv2_b1_s50 = transpose(a2_b1_s50) @ do2_b1_s50
let da2_b1_s50 = do2_b1_s50 @ transpose(v2_b1_s50)
let ds2_b1_s50 = a2_b1_s50 * (da2_b1_s50 - row_sum(a2_b1_s50 * da2_b1_s50))
