let Gwk2_2_s52 = transpose(u1_b2_s52) @ dk2_b2_s52
let Gwv2_2_s52 = transpose(u1_b2_s52) @ dv2_b2_s52
let du1_b2_s52 = dq1_b2_s52 @ transpose(wq1_2_v51) + dk1_b2_s52 @ transpose(wk1_2_v51) + dv1_b2_s52 @ transpose(wv1_2_v51) + dq2_b2_s52 @ transpose(wq2_2_v51) + dk2_b2_s52 @ transpose(wk2_2_v51) + dv2_b2_s52 @ transpose(wv2_2_v51)
let Gn1_2_s52 = col_sum(du1_b2_s52)
