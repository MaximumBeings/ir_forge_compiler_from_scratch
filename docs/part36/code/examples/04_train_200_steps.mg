let u2_b1_s31 = ln_out(x1_b1_s31, g2_1_v30, n2_1_v30)
let pre_b1_s31 = u2_b1_s31 @ w1_1_v30 + c1_1_v30
let r_b1_s31 = relu(pre_b1_s31)
let x2_b1_s31 = x1_b1_s31 + (r_b1_s31 @ w2_1_v30 + c2_1_v30)
let u1_b2_s31 = ln_out(x2_b1_s31, g1_2_v30, n1_2_v30)
let q1_b2_s31 = u1_b2_s31 @ wq1_2_v30
let k1_b2_s31 = u1_b2_s31 @ wk1_2_v30
let v1_b2_s31 = u1_b2_s31 @ wv1_2_v30
let a1_b2_s31 = softmax_rows(q1_b2_s31 @ transpose(k1_b2_s31) * 0.5 + mk)
let o1_b2_s31 = a1_b2_s31 @ v1_b2_s31
let q2_b2_s31 = u1_b2_s31 @ wq2_2_v30
let k2_b2_s31 = u1_b2_s31 @ wk2_2_v30
let v2_b2_s31 = u1_b2_s31 @ wv2_2_v30
let a2_b2_s31 = softmax_rows(q2_b2_s31 @ transpose(k2_b2_s31) * 0.5 + mk)
let o2_b2_s31 = a2_b2_s31 @ v2_b2_s31
let x1_b2_s31 = x2_b1_s31 + o1_b2_s31 @ wo1_2_v30 + o2_b2_s31 @ wo2_2_v30
let u2_b2_s31 = ln_out(x1_b2_s31, g2_2_v30, n2_2_v30)
let pre_b2_s31 = u2_b2_s31 @ w1_2_v30 + c1_2_v30
let r_b2_s31 = relu(pre_b2_s31)
let x2_b2_s31 = x1_b2_s31 + (r_b2_s31 @ w2_2_v30 + c2_2_v30)
let uf_s31 = ln_out(x2_b2_s31, gf_v30, nf_v30)
let lg_s31 = uf_s31 @ wu_v30
let dl_s31 = (exp(log_softmax(lg_s31)) * mr - y) * 0.015625
let Gwu_s31 = transpose(uf_s31) @ dl_s31
let duf_s31 = dl_s31 @ transpose(wu_v30)
let Gnf_s31 = col_sum(duf_s31)
let Ggf_s31 = col_sum(duf_s31 * ln_hat(x2_b2_s31))
let dX2_s31 = ln_back(duf_s31, x2_b2_s31, gf_v30)
let Gc2_2_s31 = col_sum(dX2_s31)
let Gw2_2_s31 = transpose(r_b2_s31) @ dX2_s31
let dpre_b2_s31 = (dX2_s31 @ transpose(w2_2_v30)) * ge(pre_b2_s31, [[0]])
let Gc1_2_s31 = col_sum(dpre_b2_s31)
