let ds2_b1_s49 = a2_b1_s49 * (da2_b1_s49 - row_sum(a2_b1_s49 * da2_b1_s49))
let dq2_b1_s49 = ds2_b1_s49 @ k2_b1_s49 * 0.5
let dk2_b1_s49 = transpose(ds2_b1_s49) @ q2_b1_s49 * 0.5
let Gwq2_1_s49 = transpose(u1_b1_s49) @ dq2_b1_s49
let Gwk2_1_s49 = transpose(u1_b1_s49) @ dk2_b1_s49
let Gwv2_1_s49 = transpose(u1_b1_s49) @ dv2_b1_s49
let du1_b1_s49 = dq1_b1_s49 @ transpose(wq1_1_v48) + dk1_b1_s49 @ transpose(wk1_1_v48) + dv1_b1_s49 @ transpose(wv1_1_v48) + dq2_b1_s49 @ transpose(wq2_1_v48) + dk2_b1_s49 @ transpose(wk2_1_v48) + dv2_b1_s49 @ transpose(wv2_1_v48)
