let Gg1_1_s40 = col_sum(du1_b1_s40 * ln_hat(x0_s40))
let dX0_s40 = dx1_b1_s40 + ln_back(du1_b1_s40, x0_s40, g1_1_v39)
let Ge_s40 = transpose(x) @ dX0_s40
let e_v40 = e_v39 - Ge_s40 * 0.5
let g1_1_v40 = g1_1_v39 - Gg1_1_s40 * 0.5
let n1_1_v40 = n1_1_v39 - Gn1_1_s40 * 0.5
