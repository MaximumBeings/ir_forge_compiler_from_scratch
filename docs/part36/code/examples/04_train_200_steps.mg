let u2_b1_s42 = ln_out(x1_b1_s42, g2_1_v41, n2_1_v41)
let pre_b1_s42 = u2_b1_s42 @ w1_1_v41 + c1_1_v41
let r_b1_s42 = relu(pre_b1_s42)
