let u1_b1_s52 = ln_out(x0_s52, g1_1_v51, n1_1_v51)
let q1_b1_s52 = u1_b1_s52 @ wq1_1_v51
let k1_b1_s52 = u1_b1_s52 @ wk1_1_v51
let v1_b1_s52 = u1_b1_s52 @ wv1_1_v51
let a1_b1_s52 = softmax_rows(q1_b1_s52 @ transpose(k1_b1_s52) * 0.5 + mk)
let o1_b1_s52 = a1_b1_s52 @ v1_b1_s52
let q2_b1_s52 = u1_b1_s52 @ wq2_1_v51
let k2_b1_s52 = u1_b1_s52 @ wk2_1_v51
let v2_b1_s52 = u1_b1_s52 @ wv2_1_v51
let a2_b1_s52 = softmax_rows(q2_b1_s52 @ transpose(k2_b1_s52) * 0.5 + mk)
let o2_b1_s52 = a2_b1_s52 @ v2_b1_s52
let x1_b1_s52 = x0_s52 + o1_b1_s52 @ wo1_1_v51 + o2_b1_s52 @ wo2_1_v51
let u2_b1_s52 = ln_out(x1_b1_s52, g2_1_v51, n2_1_v51)
let pre_b1_s52 = u2_b1_s52 @ w1_1_v51 + c1_1_v51
let r_b1_s52 = relu(pre_b1_s52)
let x2_b1_s52 = x1_b1_s52 + (r_b1_s52 @ w2_1_v51 + c2_1_v51)
let u1_b2_s52 = ln_out(x2_b1_s52, g1_2_v51, n1_2_v51)
let q1_b2_s52 = u1_b2_s52 @ wq1_2_v51
let k1_b2_s52 = u1_b2_s52 @ wk1_2_v51
let v1_b2_s52 = u1_b2_s52 @ wv1_2_v51
let a1_b2_s52 = softmax_rows(q1_b2_s52 @ transpose(k1_b2_s52) * 0.5 + mk)
let o1_b2_s52 = a1_b2_s52 @ v1_b2_s52
let q2_b2_s52 = u1_b2_s52 @ wq2_2_v51
let k2_b2_s52 = u1_b2_s52 @ wk2_2_v51
let v2_b2_s52 = u1_b2_s52 @ wv2_2_v51
let a2_b2_s52 = softmax_rows(q2_b2_s52 @ transpose(k2_b2_s52) * 0.5 + mk)
let o2_b2_s52 = a2_b2_s52 @ v2_b2_s52
let x1_b2_s52 = x2_b1_s52 + o1_b2_s52 @ wo1_2_v51 + o2_b2_s52 @ wo2_2_v51
let u2_b2_s52 = ln_out(x1_b2_s52, g2_2_v51, n2_2_v51)
let pre_b2_s52 = u2_b2_s52 @ w1_2_v51 + c1_2_v51
let r_b2_s52 = relu(pre_b2_s52)
let x2_b2_s52 = x1_b2_s52 + (r_b2_s52 @ w2_2_v51 + c2_2_v51)
let uf_s52 = ln_out(x2_b2_s52, gf_v51, nf_v51)
let lg_s52 = uf_s52 @ wu_v51
let dl_s52 = (exp(log_softmax(lg_s52)) * mr - y) * 0.015625
let Gwu_s52 = transpose(uf_s52) @ dl_s52
let duf_s52 = dl_s52 @ transpose(wu_v51)
let Gnf_s52 = col_sum(duf_s52)
let Ggf_s52 = col_sum(duf_s52 * ln_hat(x2_b2_s52))
let dX2_s52 = ln_back(duf_s52, x2_b2_s52, gf_v51)
let Gc2_2_s52 = col_sum(dX2_s52)
