let Gwo1_1_s200 = transpose(o1_b1_s200) @ dx1_b1_s200
let do1_b1_s200 = dx1_b1_s200 @ transpose(wo1_1_v199)
let dv1_b1_s200 = transpose(a1_b1_s200) @ do1_b1_s200
let da1_b1_s200 = do1_b1_s200 @ transpose(v1_b1_s200)
let ds1_b1_s200 = a1_b1_s200 * (da1_b1_s200 - row_sum(a1_b1_s200 * da1_b1_s200))
let dq1_b1_s200 = ds1_b1_s200 @ k1_b1_s200 * 0.5
let dk1_b1_s200 = transpose(ds1_b1_s200) @ q1_b1_s200 * 0.5
