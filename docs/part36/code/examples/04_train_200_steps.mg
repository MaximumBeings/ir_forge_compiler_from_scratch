let Gwk2_2_s200 = transpose(u1_b2_s200) @ dk2_b2_s200
let Gwv2_2_s200 = transpose(u1_b2_s200) @ dv2_b2_s200
let du1_b2_s200 = dq1_b2_s200 @ transpose(wq1_2_v199) + dk1_b2_s200 @ transpose(wk1_2_v199) + dv1_b2_s200 @ transpose(wv1_2_v199) + dq2_b2_s200 @ transpose(wq2_2_v199) + dk2_b2_s200 @ transpose(wk2_2_v199) + dv2_b2_s200 @ transpose(wv2_2_v199)
let Gn1_2_s200 = col_sum(du1_b2_s200)
