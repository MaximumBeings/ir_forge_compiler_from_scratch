let w1_2_v40 = w1_2_v39 - Gw1_2_s40 * 0.5
let c1_2_v40 = c1_2_v39 - Gc1_2_s40 * 0.5
let w2_2_v40 = w2_2_v39 - Gw2_2_s40 * 0.5
let c2_2_v40 = c2_2_v39 - Gc2_2_s40 * 0.5
