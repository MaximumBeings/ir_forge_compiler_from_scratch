let Gwk1_2_s52 = transpose(u1_b2_s52) @ dk1_b2_s52
let Gwv1_2_s52 = transpose(u1_b2_s52) @ dv1_b2_s52
let Gwo2_2_s52 = transpose(o2_b2_s52) @ dx1_b2_s52
let do2_b2_s52 = dx1_b2_s52 @ transpose(wo2_2_v51)
let dv2_b2_s52 = transpose(a2_b2_s52) @ do2_b2_s52
let da2_b2_s52 = do2_b2_s52 @ transpose(v2_b2_s52)
let ds2_b2_s52 = a2_b2_s52 * (da2_b2_s52 - row_sum(a2_b2_s52 * da2_b2_s52))
let dq2_b2_s52 = ds2_b2_s52 @ k2_b2_s52 * 0.5
let dk2_b2_s52 = transpose(ds2_b2_s52) @ q2_b2_s52 * 0.5
