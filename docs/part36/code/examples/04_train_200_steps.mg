let do2_b2_s41 = dx1_b2_s41 @ transpose(wo2_2_v40)
let dv2_b2_s41 = transpose(a2_b2_s41) @ do2_b2_s41
let da2_b2_s41 = do2_b2_s41 @ transpose(v2_b2_s41)
let ds2_b2_s41 = a2_b2_s41 * (da2_b2_s41 - row_sum(a2_b2_s41 * da2_b2_s41))
