let duf_s200 = dl_s200 @ transpose(wu_v199)
let Gnf_s200 = col_sum(duf_s200)
let Ggf_s200 = col_sum(duf_s200 * ln_hat(x2_b2_s200))
let dX2_s200 = ln_back(duf_s200, x2_b2_s200, gf_v199)
let Gc2_2_s200 = col_sum(dX2_s200)
let Gw2_2_s200 = transpose(r_b2_s200) @ dX2_s200
let dpre_b2_s200 = (dX2_s200 @ transpose(w2_2_v199)) * ge(pre_b2_s200, [[0]])
let Gc1_2_s200 = col_sum(dpre_b2_s200)
let Gw1_2_s200 = transpose(u2_b2_s200) @ dpre_b2_s200
let du2_b2_s200 = dpre_b2_s200 @ transpose(w1_2_v199)
let Gn2_2_s200 = col_sum(du2_b2_s200)
let Gg2_2_s200 = col_sum(du2_b2_s200 * ln_hat(x1_b2_s200))
let dx1_b2_s200 = dX2_s200 + ln_back(du2_b2_s200, x1_b2_s200, g2_2_v199)
let Gwo1_2_s200 = transpose(o1_b2_s200) @ dx1_b2_s200
let do1_b2_s200 = dx1_b2_s200 @ transpose(wo1_2_v199)
let dv1_b2_s200 = transpose(a1_b2_s200) @ do1_b2_s200
let da1_b2_s200 = do1_b2_s200 @ transpose(v1_b2_s200)
let ds1_b2_s200 = a1_b2_s200 * (da1_b2_s200 - row_sum(a1_b2_s200 * da1_b2_s200))
let dq1_b2_s200 = ds1_b2_s200 @ k1_b2_s200 * 0.5
let dk1_b2_s200 = transpose(ds1_b2_s200) @ q1_b2_s200 * 0.5
let Gwq1_2_s200 = transpose(u1_b2_s200) @ dq1_b2_s200
let Gwk1_2_s200 = transpose(u1_b2_s200) @ dk1_b2_s200
let Gwv1_2_s200 = transpose(u1_b2_s200) @ dv1_b2_s200
let Gwo2_2_s200 = transpose(o2_b2_s200) @ dx1_b2_s200
let do2_b2_s200 = dx1_b2_s200 @ transpose(wo2_2_v199)
let dv2_b2_s200 = transpose(a2_b2_s200) @ do2_b2_s200
let da2_b2_s200 = do2_b2_s200 @ transpose(v2_b2_s200)
let ds2_b2_s200 = a2_b2_s200 * (da2_b2_s200 - row_sum(a2_b2_s200 * da2_b2_s200))
let dq2_b2_s200 = ds2_b2_s200 @ k2_b2_s200 * 0.5
