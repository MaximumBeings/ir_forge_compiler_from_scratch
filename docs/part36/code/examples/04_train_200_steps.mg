# ---- step 42: forward pass, backward pass, update
let x0_s42 = x @ e_v41 + ps
let u1_b1_s42 = ln_out(x0_s42, g1_1_v41, n1_1_v41)
let q1_b1_s42 = u1_b1_s42 @ wq1_1_v41
