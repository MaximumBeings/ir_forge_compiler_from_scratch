let n1_2_v49 = n1_2_v48 - Gn1_2_s49 * 0.5
let wq1_2_v49 = wq1_2_v48 - Gwq1_2_s49 * 0.5
let wk1_2_v49 = wk1_2_v48 - Gwk1_2_s49 * 0.5
