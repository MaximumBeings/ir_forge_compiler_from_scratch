let dk2_b1_s52 = transpose(ds2_b1_s52) @ q2_b1_s52 * 0.5
let Gwq2_1_s52 = transpose(u1_b1_s52) @ dq2_b1_s52
let Gwk2_1_s52 = transpose(u1_b1_s52) @ dk2_b1_s52
let Gwv2_1_s52 = transpose(u1_b1_s52) @ dv2_b1_s52
let du1_b1_s52 = dq1_b1_s52 @ transpose(wq1_1_v51) + dk1_b1_s52 @ transpose(wk1_1_v51) + dv1_b1_s52 @ transpose(wv1_1_v51) + dq2_b1_s52 @ transpose(wq2_1_v51) + dk2_b1_s52 @ transpose(wk2_1_v51) + dv2_b1_s52 @ transpose(wv2_1_v51)
