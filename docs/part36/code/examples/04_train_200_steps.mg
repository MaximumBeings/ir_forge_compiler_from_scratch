let wo2_2_v48 = wo2_2_v47 - Gwo2_2_s48 * 0.5
let g2_2_v48 = g2_2_v47 - Gg2_2_s48 * 0.5
let n2_2_v48 = n2_2_v47 - Gn2_2_s48 * 0.5
let w1_2_v48 = w1_2_v47 - Gw1_2_s48 * 0.5
let c1_2_v48 = c1_2_v47 - Gc1_2_s48 * 0.5
let w2_2_v48 = w2_2_v47 - Gw2_2_s48 * 0.5
let c2_2_v48 = c2_2_v47 - Gc2_2_s48 * 0.5
let gf_v48 = gf_v47 - Ggf_s48 * 0.5
