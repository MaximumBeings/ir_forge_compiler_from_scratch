let Gwv1_1_s200 = transpose(u1_b1_s200) @ dv1_b1_s200
let Gwo2_1_s200 = transpose(o2_b1_s200) @ dx1_b1_s200
let do2_b1_s200 = dx1_b1_s200 @ transpose(wo2_1_v199)
let dv2_b1_s200 = transpose(a2_b1_s200) @ do2_b1_s200
let da2_b1_s200 = do2_b1_s200 @ transpose(v2_b1_s200)
let ds2_b1_s200 = a2_b1_s200 * (da2_b1_s200 - row_sum(a2_b1_s200 * da2_b1_s200))
let dq2_b1_s200 = ds2_b1_s200 @ k2_b1_s200 * 0.5
let dk2_b1_s200 = transpose(ds2_b1_s200) @ q2_b1_s200 * 0.5
let Gwq2_1_s200 = transpose(u1_b1_s200) @ dq2_b1_s200
let Gwk2_1_s200 = transpose(u1_b1_s200) @ dk2_b1_s200
let Gwv2_1_s200 = transpose(u1_b1_s200) @ dv2_b1_s200
let du1_b1_s200 = dq1_b1_s200 @ transpose(wq1_1_v199) + dk1_b1_s200 @ transpose(wk1_1_v199) + dv1_b1_s200 @ transpose(wv1_1_v199) + dq2_b1_s200 @ transpose(wq2_1_v199) + dk2_b1_s200 @ transpose(wk2_1_v199) + dv2_b1_s200 @ transpose(wv2_1_v199)
let Gn1_1_s200 = col_sum(du1_b1_s200)
let Gg1_1_s200 = col_sum(du1_b1_s200 * ln_hat(x0_s200))
let dX0_s200 = dx1_b1_s200 + ln_back(du1_b1_s200, x0_s200, g1_1_v199)
let Ge_s200 = transpose(x) @ dX0_s200
let e_v200 = e_v199 - Ge_s200 * 0.5
let g1_1_v200 = g1_1_v199 - Gg1_1_s200 * 0.5
