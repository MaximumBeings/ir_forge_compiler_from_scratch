let du2_b2_s32 = dpre_b2_s32 @ transpose(w1_2_v31)
let Gn2_2_s32 = col_sum(du2_b2_s32)
let Gg2_2_s32 = col_sum(du2_b2_s32 * ln_hat(x1_b2_s32))
let dx1_b2_s32 = dX2_s32 + ln_back(du2_b2_s32, x1_b2_s32, g2_2_v31)
let Gwo1_2_s32 = transpose(o1_b2_s32) @ dx1_b2_s32
let do1_b2_s32 = dx1_b2_s32 @ transpose(wo1_2_v31)
let dv1_b2_s32 = transpose(a1_b2_s32) @ do1_b2_s32
let da1_b2_s32 = do1_b2_s32 @ transpose(v1_b2_s32)
let ds1_b2_s32 = a1_b2_s32 * (da1_b2_s32 - row_sum(a1_b2_s32 * da1_b2_s32))
