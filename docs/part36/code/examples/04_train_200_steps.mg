let k2_b1_s49 = u1_b1_s49 @ wk2_1_v48
let v2_b1_s49 = u1_b1_s49 @ wv2_1_v48
let a2_b1_s49 = softmax_rows(q2_b1_s49 @ transpose(k2_b1_s49) * 0.5 + mk)
let o2_b1_s49 = a2_b1_s49 @ v2_b1_s49
let x1_b1_s49 = x0_s49 + o1_b1_s49 @ wo1_1_v48 + o2_b1_s49 @ wo2_1_v48
let u2_b1_s49 = ln_out(x1_b1_s49, g2_1_v48, n2_1_v48)
