let wu_v49 = wu_v48 - Gwu_s49 * 0.5
# ---- step 50: forward pass, backward pass, update
let x0_s50 = x @ e_v49 + ps
let u1_b1_s50 = ln_out(x0_s50, g1_1_v49, n1_1_v49)
let q1_b1_s50 = u1_b1_s50 @ wq1_1_v49
