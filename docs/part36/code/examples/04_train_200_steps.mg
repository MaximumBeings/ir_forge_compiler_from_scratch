let o2_b2_s100 = a2_b2_s100 @ v2_b2_s100
let x1_b2_s100 = x2_b1_s100 + o1_b2_s100 @ wo1_2_v99 + o2_b2_s100 @ wo2_2_v99
let u2_b2_s100 = ln_out(x1_b2_s100, g2_2_v99, n2_2_v99)
