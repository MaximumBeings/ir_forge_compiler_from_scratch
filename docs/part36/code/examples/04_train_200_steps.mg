let wq2_1_v31 = wq2_1_v30 - Gwq2_1_s31 * 0.5
let wk2_1_v31 = wk2_1_v30 - Gwk2_1_s31 * 0.5
let wv2_1_v31 = wv2_1_v30 - Gwv2_1_s31 * 0.5
let wo2_1_v31 = wo2_1_v30 - Gwo2_1_s31 * 0.5
