# Chapter 30's architecture as a causal language model, with its hand-derived backward pass: two blocks, each with TWO attention heads of width 4 and a feed-forward
# network of width 16, pre-norm residual connections, a final layer norm. 16 sequences of 7 tokens are stacked into one matrix of 112 rows; attention is over all 112
# rows with a mask that allows a position to see only earlier positions of its OWN sequence.
# (This listing is one training step with every step's suffix removed: the parameters are named after their matrices, e.g. wq1_2 is block 2's query matrix for head 1.
# In the training programs each step's lets carry a suffix such as _s7, and the parameters are numbered per step, e.g. wq1_2_v200.)

def softmax_rows(m: tensor[112x112]) = exp(m - row_max(m)) / row_sum(exp(m - row_max(m)))
def ln_sigma(h: tensor[112x8]) = sqrt(row_mean((h - row_mean(h)) * (h - row_mean(h))) + 1e-05)
def ln_hat(h: tensor[112x8]) = (h - row_mean(h)) / ln_sigma(h)
def ln_out(h: tensor[112x8], g: tensor[1x8], t: tensor[1x8]) = ln_hat(h) * g + t
def ln_back(d: tensor[112x8], h: tensor[112x8], g: tensor[1x8]) = ((d * g) - row_mean(d * g) - ln_hat(h) * row_mean((d * g) * ln_hat(h))) / ln_sigma(h)
def log_softmax(z: tensor[112x4]) = z - row_max(z) - log(row_sum(exp(z - row_max(z))))

# ---- the forward pass, one let per step
let x0_ = x @ e + ps
let u1_b1_ = ln_out(x0_, g1_1, n1_1)
let q1_b1_ = u1_b1_ @ wq1_1
let k1_b1_ = u1_b1_ @ wk1_1
let v1_b1_ = u1_b1_ @ wv1_1
let a1_b1_ = softmax_rows(q1_b1_ @ transpose(k1_b1_) * 0.5 + mk)
let o1_b1_ = a1_b1_ @ v1_b1_
let q2_b1_ = u1_b1_ @ wq2_1
let k2_b1_ = u1_b1_ @ wk2_1
let v2_b1_ = u1_b1_ @ wv2_1
let a2_b1_ = softmax_rows(q2_b1_ @ transpose(k2_b1_) * 0.5 + mk)
let o2_b1_ = a2_b1_ @ v2_b1_
let x1_b1_ = x0_ + o1_b1_ @ wo1_1 + o2_b1_ @ wo2_1
let u2_b1_ = ln_out(x1_b1_, g2_1, n2_1)
let pre_b1_ = u2_b1_ @ w1_1 + c1_1
let r_b1_ = relu(pre_b1_)
let x2_b1_ = x1_b1_ + (r_b1_ @ w2_1 + c2_1)
let u1_b2_ = ln_out(x2_b1_, g1_2, n1_2)
let q1_b2_ = u1_b2_ @ wq1_2
let k1_b2_ = u1_b2_ @ wk1_2
let v1_b2_ = u1_b2_ @ wv1_2
let a1_b2_ = softmax_rows(q1_b2_ @ transpose(k1_b2_) * 0.5 + mk)
let o1_b2_ = a1_b2_ @ v1_b2_
let q2_b2_ = u1_b2_ @ wq2_2
let k2_b2_ = u1_b2_ @ wk2_2
let v2_b2_ = u1_b2_ @ wv2_2
let a2_b2_ = softmax_rows(q2_b2_ @ transpose(k2_b2_) * 0.5 + mk)
let o2_b2_ = a2_b2_ @ v2_b2_
let x1_b2_ = x2_b1_ + o1_b2_ @ wo1_2 + o2_b2_ @ wo2_2
let u2_b2_ = ln_out(x1_b2_, g2_2, n2_2)
let pre_b2_ = u2_b2_ @ w1_2 + c1_2
let r_b2_ = relu(pre_b2_)
let x2_b2_ = x1_b2_ + (r_b2_ @ w2_2 + c2_2)
let uf_ = ln_out(x2_b2_, gf, nf)
let lg_ = uf_ @ wu
# ---- the loss, and the number of correct predictions
# loss    = col_sum(row_sum(y * log_softmax(lg_))) * -0.015625
# correct = col_sum(row_sum(ge(lg_, row_max(lg_)) * y))

# ---- the backward pass, one let per step, working backwards from the loss
let dl_ = (exp(log_softmax(lg_)) * mr - y) * 0.015625
let Gwu_ = transpose(uf_) @ dl_
let duf_ = dl_ @ transpose(wu)
let Gnf_ = col_sum(duf_)
let Ggf_ = col_sum(duf_ * ln_hat(x2_b2_))
let dX2_ = ln_back(duf_, x2_b2_, gf)
let Gc2_2_ = col_sum(dX2_)
let Gw2_2_ = transpose(r_b2_) @ dX2_
let dpre_b2_ = (dX2_ @ transpose(w2_2)) * ge(pre_b2_, [[0]])
let Gc1_2_ = col_sum(dpre_b2_)
let Gw1_2_ = transpose(u2_b2_) @ dpre_b2_
let du2_b2_ = dpre_b2_ @ transpose(w1_2)
let Gn2_2_ = col_sum(du2_b2_)
let Gg2_2_ = col_sum(du2_b2_ * ln_hat(x1_b2_))
let dx1_b2_ = dX2_ + ln_back(du2_b2_, x1_b2_, g2_2)
let Gwo1_2_ = transpose(o1_b2_) @ dx1_b2_
let do1_b2_ = dx1_b2_ @ transpose(wo1_2)
let dv1_b2_ = transpose(a1_b2_) @ do1_b2_
let da1_b2_ = do1_b2_ @ transpose(v1_b2_)
let ds1_b2_ = a1_b2_ * (da1_b2_ - row_sum(a1_b2_ * da1_b2_))
let dq1_b2_ = ds1_b2_ @ k1_b2_ * 0.5
let dk1_b2_ = transpose(ds1_b2_) @ q1_b2_ * 0.5
let Gwq1_2_ = transpose(u1_b2_) @ dq1_b2_
let Gwk1_2_ = transpose(u1_b2_) @ dk1_b2_
let Gwv1_2_ = transpose(u1_b2_) @ dv1_b2_
let Gwo2_2_ = transpose(o2_b2_) @ dx1_b2_
let do2_b2_ = dx1_b2_ @ transpose(wo2_2)
let dv2_b2_ = transpose(a2_b2_) @ do2_b2_
let da2_b2_ = do2_b2_ @ transpose(v2_b2_)
let ds2_b2_ = a2_b2_ * (da2_b2_ - row_sum(a2_b2_ * da2_b2_))
let dq2_b2_ = ds2_b2_ @ k2_b2_ * 0.5
let dk2_b2_ = transpose(ds2_b2_) @ q2_b2_ * 0.5
let Gwq2_2_ = transpose(u1_b2_) @ dq2_b2_
let Gwk2_2_ = transpose(u1_b2_) @ dk2_b2_
let Gwv2_2_ = transpose(u1_b2_) @ dv2_b2_
let du1_b2_ = dq1_b2_ @ transpose(wq1_2) + dk1_b2_ @ transpose(wk1_2) + dv1_b2_ @ transpose(wv1_2) + dq2_b2_ @ transpose(wq2_2) + dk2_b2_ @ transpose(wk2_2) + dv2_b2_ @ transpose(wv2_2)
let Gn1_2_ = col_sum(du1_b2_)
let Gg1_2_ = col_sum(du1_b2_ * ln_hat(x2_b1_))
let dX1_ = dx1_b2_ + ln_back(du1_b2_, x2_b1_, g1_2)
let Gc2_1_ = col_sum(dX1_)
let Gw2_1_ = transpose(r_b1_) @ dX1_
let dpre_b1_ = (dX1_ @ transpose(w2_1)) * ge(pre_b1_, [[0]])
let Gc1_1_ = col_sum(dpre_b1_)
let Gw1_1_ = transpose(u2_b1_) @ dpre_b1_
let du2_b1_ = dpre_b1_ @ transpose(w1_1)
let Gn2_1_ = col_sum(du2_b1_)
let Gg2_1_ = col_sum(du2_b1_ * ln_hat(x1_b1_))
let dx1_b1_ = dX1_ + ln_back(du2_b1_, x1_b1_, g2_1)
let Gwo1_1_ = transpose(o1_b1_) @ dx1_b1_
let do1_b1_ = dx1_b1_ @ transpose(wo1_1)
let dv1_b1_ = transpose(a1_b1_) @ do1_b1_
let da1_b1_ = do1_b1_ @ transpose(v1_b1_)
let ds1_b1_ = a1_b1_ * (da1_b1_ - row_sum(a1_b1_ * da1_b1_))
let dq1_b1_ = ds1_b1_ @ k1_b1_ * 0.5
let dk1_b1_ = transpose(ds1_b1_) @ q1_b1_ * 0.5
let Gwq1_1_ = transpose(u1_b1_) @ dq1_b1_
let Gwk1_1_ = transpose(u1_b1_) @ dk1_b1_
let Gwv1_1_ = transpose(u1_b1_) @ dv1_b1_
let Gwo2_1_ = transpose(o2_b1_) @ dx1_b1_
let do2_b1_ = dx1_b1_ @ transpose(wo2_1)
let dv2_b1_ = transpose(a2_b1_) @ do2_b1_
let da2_b1_ = do2_b1_ @ transpose(v2_b1_)
let ds2_b1_ = a2_b1_ * (da2_b1_ - row_sum(a2_b1_ * da2_b1_))
let dq2_b1_ = ds2_b1_ @ k2_b1_ * 0.5
let dk2_b1_ = transpose(ds2_b1_) @ q2_b1_ * 0.5
let Gwq2_1_ = transpose(u1_b1_) @ dq2_b1_
let Gwk2_1_ = transpose(u1_b1_) @ dk2_b1_
let Gwv2_1_ = transpose(u1_b1_) @ dv2_b1_
let du1_b1_ = dq1_b1_ @ transpose(wq1_1) + dk1_b1_ @ transpose(wk1_1) + dv1_b1_ @ transpose(wv1_1) + dq2_b1_ @ transpose(wq2_1) + dk2_b1_ @ transpose(wk2_1) + dv2_b1_ @ transpose(wv2_1)
let Gn1_1_ = col_sum(du1_b1_)
let Gg1_1_ = col_sum(du1_b1_ * ln_hat(x0_))
let dX0_ = dx1_b1_ + ln_back(du1_b1_, x0_, g1_1)
let Ge_ = transpose(x) @ dX0_

# ---- the update, one per matrix (lr = 0.5)
let e_new = e - Ge_ * 0.5
let g1_1_new = g1_1 - Gg1_1_ * 0.5
let n1_1_new = n1_1 - Gn1_1_ * 0.5
let wq1_1_new = wq1_1 - Gwq1_1_ * 0.5
let wk1_1_new = wk1_1 - Gwk1_1_ * 0.5
let wv1_1_new = wv1_1 - Gwv1_1_ * 0.5
let wo1_1_new = wo1_1 - Gwo1_1_ * 0.5
let wq2_1_new = wq2_1 - Gwq2_1_ * 0.5
let wk2_1_new = wk2_1 - Gwk2_1_ * 0.5
let wv2_1_new = wv2_1 - Gwv2_1_ * 0.5
let wo2_1_new = wo2_1 - Gwo2_1_ * 0.5
let g2_1_new = g2_1 - Gg2_1_ * 0.5
let n2_1_new = n2_1 - Gn2_1_ * 0.5
let w1_1_new = w1_1 - Gw1_1_ * 0.5
let c1_1_new = c1_1 - Gc1_1_ * 0.5
let w2_1_new = w2_1 - Gw2_1_ * 0.5
let c2_1_new = c2_1 - Gc2_1_ * 0.5
let g1_2_new = g1_2 - Gg1_2_ * 0.5
let n1_2_new = n1_2 - Gn1_2_ * 0.5
let wq1_2_new = wq1_2 - Gwq1_2_ * 0.5
let wk1_2_new = wk1_2 - Gwk1_2_ * 0.5
let wv1_2_new = wv1_2 - Gwv1_2_ * 0.5
let wo1_2_new = wo1_2 - Gwo1_2_ * 0.5
let wq2_2_new = wq2_2 - Gwq2_2_ * 0.5
let wk2_2_new = wk2_2 - Gwk2_2_ * 0.5
let wv2_2_new = wv2_2 - Gwv2_2_ * 0.5
let wo2_2_new = wo2_2 - Gwo2_2_ * 0.5
let g2_2_new = g2_2 - Gg2_2_ * 0.5
let n2_2_new = n2_2 - Gn2_2_ * 0.5
let w1_2_new = w1_2 - Gw1_2_ * 0.5
let c1_2_new = c1_2 - Gc1_2_ * 0.5
let w2_2_new = w2_2 - Gw2_2_ * 0.5
let c2_2_new = c2_2 - Gc2_2_ * 0.5
let gf_new = gf - Ggf_ * 0.5
let nf_new = nf - Gnf_ * 0.5
let wu_new = wu - Gwu_ * 0.5
