# Chapter 33's attention classifier at its initial weights. The first print is the LOSS; the next four are Chapter 33's HAND-DERIVED gradients for q0, wk0, wv0 and wo0.
def softmax_rows(m: tensor[24x4]) = exp(m - row_max(m)) / row_sum(exp(m - row_max(m)))
def attn_matrix(x: tensor[96x5], q: tensor[1x3], wk: tensor[5x3]) = softmax_rows(reshape((x @ wk) @ transpose(q) * 0.5773502691896258, 24, 4))
def context(x: tensor[96x5], g: tensor[24x96], q: tensor[1x3], wk: tensor[5x3], wv: tensor[5x3]) = g @ ((x @ wv) * reshape(attn_matrix(x, q, wk), 96, 1))
def logits(x: tensor[96x5], g: tensor[24x96], q: tensor[1x3], wk: tensor[5x3], wv: tensor[5x3], wo: tensor[3x5]) = context(x, g, q, wk, wv) @ wo
def log_softmax(z: tensor[24x5]) = z - row_max(z) - log(row_sum(exp(z - row_max(z))))
def loss(x: tensor[96x5], g: tensor[24x96], q: tensor[1x3], wk: tensor[5x3], wv: tensor[5x3], wo: tensor[3x5], y: tensor[24x5]) = col_sum(row_sum(y * log_softmax(logits(x, g, q, wk, wv, wo)))) * -0.041666666666666664
def correct(x: tensor[96x5], g: tensor[24x96], q: tensor[1x3], wk: tensor[5x3], wv: tensor[5x3], wo: tensor[3x5], y: tensor[24x5]) = col_sum(row_sum(ge(logits(x, g, q, wk, wv, wo), row_max(logits(x, g, q, wk, wv, wo))) * y))
def d_logits(x: tensor[96x5], g: tensor[24x96], q: tensor[1x3], wk: tensor[5x3], wv: tensor[5x3], wo: tensor[3x5], y: tensor[24x5]) = (exp(log_softmax(logits(x, g, q, wk, wv, wo))) - y) * 0.041666666666666664
def grad_wo(x: tensor[96x5], g: tensor[24x96], q: tensor[1x3], wk: tensor[5x3], wv: tensor[5x3], wo: tensor[3x5], y: tensor[24x5]) = transpose(context(x, g, q, wk, wv)) @ d_logits(x, g, q, wk, wv, wo, y)
def d_context_rows(x: tensor[96x5], g: tensor[24x96], q: tensor[1x3], wk: tensor[5x3], wv: tensor[5x3], wo: tensor[3x5], y: tensor[24x5]) = transpose(g) @ (d_logits(x, g, q, wk, wv, wo, y) @ transpose(wo))
def grad_wv(x: tensor[96x5], g: tensor[24x96], q: tensor[1x3], wk: tensor[5x3], wv: tensor[5x3], wo: tensor[3x5], y: tensor[24x5]) = transpose(x) @ (d_context_rows(x, g, q, wk, wv, wo, y) * reshape(attn_matrix(x, q, wk), 96, 1))
def d_attn_matrix(x: tensor[96x5], g: tensor[24x96], q: tensor[1x3], wk: tensor[5x3], wv: tensor[5x3], wo: tensor[3x5], y: tensor[24x5]) = reshape(row_sum(d_context_rows(x, g, q, wk, wv, wo, y) * (x @ wv)), 24, 4)
def d_scores(x: tensor[96x5], g: tensor[24x96], q: tensor[1x3], wk: tensor[5x3], wv: tensor[5x3], wo: tensor[3x5], y: tensor[24x5]) = reshape(attn_matrix(x, q, wk) * (d_attn_matrix(x, g, q, wk, wv, wo, y) - row_sum(attn_matrix(x, q, wk) * d_attn_matrix(x, g, q, wk, wv, wo, y))), 96, 1)
def grad_q(x: tensor[96x5], g: tensor[24x96], q: tensor[1x3], wk: tensor[5x3], wv: tensor[5x3], wo: tensor[3x5], y: tensor[24x5]) = transpose(d_scores(x, g, q, wk, wv, wo, y)) @ (x @ wk) * 0.5773502691896258
def grad_wk(x: tensor[96x5], g: tensor[24x96], q: tensor[1x3], wk: tensor[5x3], wv: tensor[5x3], wo: tensor[3x5], y: tensor[24x5]) = transpose(x) @ (d_scores(x, g, q, wk, wv, wo, y) @ q) * 0.5773502691896258
