# Model B: attention pooling, then a layer normalization, a ReLU feed-forward network and a residual connection, then a linear read-out.
# B sequences are stacked: x has B*4 rows (the tokens of sequence 0, then sequence 1, ...) and g (B x B*4) adds up the 4 rows belonging to each sequence.
# (The same functions exist again with the suffix _27 for chunks of 27 sequences; only the sizes differ.)

def softmax_rows(m: tensor[54x4]) = exp(m - row_max(m)) / row_sum(exp(m - row_max(m)))
def attn_matrix(x: tensor[216x3], q: tensor[1x4], wk: tensor[3x4]) = softmax_rows(reshape((x @ wk) @ transpose(q) * 0.5, 54, 4))
def pooled(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4]) = g @ ((x @ wv) * reshape(attn_matrix(x, q, wk), 216, 1))
def ln_sigma(h: tensor[54x4]) = sqrt(row_mean((h - row_mean(h)) * (h - row_mean(h))) + 1e-05)
def ln_hat(h: tensor[54x4]) = (h - row_mean(h)) / ln_sigma(h)
def ln_out(h: tensor[54x4], gm: tensor[1x4], bt: tensor[1x4]) = ln_hat(h) * gm + bt
def hidden_pre(h: tensor[54x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8]) = ln_out(h, gm, bt) @ w1 + b1
def block(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8], w2: tensor[8x4], b2: tensor[1x4]) = pooled(x, g, q, wk, wv) + (relu(hidden_pre(pooled(x, g, q, wk, wv), gm, bt, w1, b1)) @ w2 + b2)
def logits(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8], w2: tensor[8x4], b2: tensor[1x4], wo: tensor[4x2]) = block(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2) @ wo
def log_softmax(z: tensor[54x2]) = z - row_max(z) - log(row_sum(exp(z - row_max(z))))
def loss(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8], w2: tensor[8x4], b2: tensor[1x4], wo: tensor[4x2], y: tensor[54x2]) = col_sum(row_sum(y * log_softmax(logits(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo)))) * -0.018518518518518517
def correct(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8], w2: tensor[8x4], b2: tensor[1x4], wo: tensor[4x2], y: tensor[54x2]) = col_sum(row_sum(ge(logits(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo), row_max(logits(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo))) * y))
def d_logits(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8], w2: tensor[8x4], b2: tensor[1x4], wo: tensor[4x2], y: tensor[54x2]) = (exp(log_softmax(logits(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo))) - y) * 0.018518518518518517
def grad_wo(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8], w2: tensor[8x4], b2: tensor[1x4], wo: tensor[4x2], y: tensor[54x2]) = transpose(block(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2)) @ d_logits(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo, y)
def d_z(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8], w2: tensor[8x4], b2: tensor[1x4], wo: tensor[4x2], y: tensor[54x2]) = d_logits(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo, y) @ transpose(wo)
def grad_b2(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8], w2: tensor[8x4], b2: tensor[1x4], wo: tensor[4x2], y: tensor[54x2]) = col_sum(d_z(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo, y))
def grad_w2(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8], w2: tensor[8x4], b2: tensor[1x4], wo: tensor[4x2], y: tensor[54x2]) = transpose(relu(hidden_pre(pooled(x, g, q, wk, wv), gm, bt, w1, b1))) @ d_z(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo, y)
def d_pre(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8], w2: tensor[8x4], b2: tensor[1x4], wo: tensor[4x2], y: tensor[54x2]) = (d_z(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo, y) @ transpose(w2)) * ge(hidden_pre(pooled(x, g, q, wk, wv), gm, bt, w1, b1), [[0]])
def grad_b1(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8], w2: tensor[8x4], b2: tensor[1x4], wo: tensor[4x2], y: tensor[54x2]) = col_sum(d_pre(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo, y))
def grad_w1(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8], w2: tensor[8x4], b2: tensor[1x4], wo: tensor[4x2], y: tensor[54x2]) = transpose(ln_out(pooled(x, g, q, wk, wv), gm, bt)) @ d_pre(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo, y)
def d_u(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8], w2: tensor[8x4], b2: tensor[1x4], wo: tensor[4x2], y: tensor[54x2]) = d_pre(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo, y) @ transpose(w1)
def grad_bt(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8], w2: tensor[8x4], b2: tensor[1x4], wo: tensor[4x2], y: tensor[54x2]) = col_sum(d_u(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo, y))
def grad_gm(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8], w2: tensor[8x4], b2: tensor[1x4], wo: tensor[4x2], y: tensor[54x2]) = col_sum(d_u(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo, y) * ln_hat(pooled(x, g, q, wk, wv)))
def d_hat(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8], w2: tensor[8x4], b2: tensor[1x4], wo: tensor[4x2], y: tensor[54x2]) = d_u(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo, y) * gm
def d_h(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8], w2: tensor[8x4], b2: tensor[1x4], wo: tensor[4x2], y: tensor[54x2]) = d_z(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo, y) + (d_hat(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo, y) - row_mean(d_hat(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo, y)) - ln_hat(pooled(x, g, q, wk, wv)) * row_mean(d_hat(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo, y) * ln_hat(pooled(x, g, q, wk, wv)))) / ln_sigma(pooled(x, g, q, wk, wv))
def d_ctx_rows(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8], w2: tensor[8x4], b2: tensor[1x4], wo: tensor[4x2], y: tensor[54x2]) = transpose(g) @ d_h(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo, y)
def grad_wv(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8], w2: tensor[8x4], b2: tensor[1x4], wo: tensor[4x2], y: tensor[54x2]) = transpose(x) @ (d_ctx_rows(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo, y) * reshape(attn_matrix(x, q, wk), 216, 1))
def d_attn_matrix(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8], w2: tensor[8x4], b2: tensor[1x4], wo: tensor[4x2], y: tensor[54x2]) = reshape(row_sum(d_ctx_rows(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo, y) * (x @ wv)), 54, 4)
def d_scores(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8], w2: tensor[8x4], b2: tensor[1x4], wo: tensor[4x2], y: tensor[54x2]) = reshape(attn_matrix(x, q, wk) * (d_attn_matrix(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo, y) - row_sum(attn_matrix(x, q, wk) * d_attn_matrix(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo, y))), 216, 1)
def grad_q(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8], w2: tensor[8x4], b2: tensor[1x4], wo: tensor[4x2], y: tensor[54x2]) = transpose(d_scores(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo, y)) @ (x @ wk) * 0.5
def grad_wk(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], gm: tensor[1x4], bt: tensor[1x4], w1: tensor[4x8], b1: tensor[1x8], w2: tensor[8x4], b2: tensor[1x4], wo: tensor[4x2], y: tensor[54x2]) = transpose(x) @ (d_scores(x, g, q, wk, wv, gm, bt, w1, b1, w2, b2, wo, y) @ q) * 0.5
