# Model A: attention pooling and a linear read-out (no layer normalization, feed-forward network or residual connection).
# B sequences are stacked: x has B*4 rows (the tokens of sequence 0, then sequence 1, ...) and g (B x B*4) adds up the 4 rows belonging to each sequence.

def softmax_rows(m: tensor[54x4]) = exp(m - row_max(m)) / row_sum(exp(m - row_max(m)))
def attn_matrix(x: tensor[216x3], q: tensor[1x4], wk: tensor[3x4]) = softmax_rows(reshape((x @ wk) @ transpose(q) * 0.5, 54, 4))
def pooled(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4]) = g @ ((x @ wv) * reshape(attn_matrix(x, q, wk), 216, 1))
def block(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4]) = pooled(x, g, q, wk, wv)
def logits(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], wo: tensor[4x2]) = block(x, g, q, wk, wv) @ wo
def log_softmax(z: tensor[54x2]) = z - row_max(z) - log(row_sum(exp(z - row_max(z))))
def loss(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], wo: tensor[4x2], y: tensor[54x2]) = col_sum(row_sum(y * log_softmax(logits(x, g, q, wk, wv, wo)))) * -0.018518518518518517
def correct(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], wo: tensor[4x2], y: tensor[54x2]) = col_sum(row_sum(ge(logits(x, g, q, wk, wv, wo), row_max(logits(x, g, q, wk, wv, wo))) * y))
def d_logits(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], wo: tensor[4x2], y: tensor[54x2]) = (exp(log_softmax(logits(x, g, q, wk, wv, wo))) - y) * 0.018518518518518517
def grad_wo(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], wo: tensor[4x2], y: tensor[54x2]) = transpose(block(x, g, q, wk, wv)) @ d_logits(x, g, q, wk, wv, wo, y)
def d_z(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], wo: tensor[4x2], y: tensor[54x2]) = d_logits(x, g, q, wk, wv, wo, y) @ transpose(wo)
def d_ctx_rows(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], wo: tensor[4x2], y: tensor[54x2]) = transpose(g) @ d_z(x, g, q, wk, wv, wo, y)
def grad_wv(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], wo: tensor[4x2], y: tensor[54x2]) = transpose(x) @ (d_ctx_rows(x, g, q, wk, wv, wo, y) * reshape(attn_matrix(x, q, wk), 216, 1))
def d_attn_matrix(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], wo: tensor[4x2], y: tensor[54x2]) = reshape(row_sum(d_ctx_rows(x, g, q, wk, wv, wo, y) * (x @ wv)), 54, 4)
def d_scores(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], wo: tensor[4x2], y: tensor[54x2]) = reshape(attn_matrix(x, q, wk) * (d_attn_matrix(x, g, q, wk, wv, wo, y) - row_sum(attn_matrix(x, q, wk) * d_attn_matrix(x, g, q, wk, wv, wo, y))), 216, 1)
def grad_q(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], wo: tensor[4x2], y: tensor[54x2]) = transpose(d_scores(x, g, q, wk, wv, wo, y)) @ (x @ wk) * 0.5
def grad_wk(x: tensor[216x3], g: tensor[54x216], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], wo: tensor[4x2], y: tensor[54x2]) = transpose(x) @ (d_scores(x, g, q, wk, wv, wo, y) @ q) * 0.5

def softmax_rows_27(m: tensor[27x4]) = exp(m - row_max(m)) / row_sum(exp(m - row_max(m)))
def attn_matrix_27(x: tensor[108x3], q: tensor[1x4], wk: tensor[3x4]) = softmax_rows_27(reshape((x @ wk) @ transpose(q) * 0.5, 27, 4))
def pooled_27(x: tensor[108x3], g: tensor[27x108], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4]) = g @ ((x @ wv) * reshape(attn_matrix_27(x, q, wk), 108, 1))
def block_27(x: tensor[108x3], g: tensor[27x108], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4]) = pooled_27(x, g, q, wk, wv)
def logits_27(x: tensor[108x3], g: tensor[27x108], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], wo: tensor[4x2]) = block_27(x, g, q, wk, wv) @ wo
def log_softmax_27(z: tensor[27x2]) = z - row_max(z) - log(row_sum(exp(z - row_max(z))))
def loss_27(x: tensor[108x3], g: tensor[27x108], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], wo: tensor[4x2], y: tensor[27x2]) = col_sum(row_sum(y * log_softmax_27(logits_27(x, g, q, wk, wv, wo)))) * -0.037037037037037035
def correct_27(x: tensor[108x3], g: tensor[27x108], q: tensor[1x4], wk: tensor[3x4], wv: tensor[3x4], wo: tensor[4x2], y: tensor[27x2]) = col_sum(row_sum(ge(logits_27(x, g, q, wk, wv, wo), row_max(logits_27(x, g, q, wk, wv, wo))) * y))

